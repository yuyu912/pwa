<view class="page"><text class="heading">我的穿搭风格</text><text class="desc">只统计你亲自确认过的真实穿搭，不评价身材，也不做虚拟试穿。</text><text wx:if="{{error}}" class="error">{{error}}</text><block wx:if="{{profile}}"><view class="stage"><text class="count">{{profile.count}} 套</text><text>{{profile.stageText}}</text></view><view class="card"><text class="title">常穿颜色</text><view class="chips"><text wx:for="{{profile.colors}}" wx:key="name">{{item.name}} · {{item.count}}</text></view></view><view class="card"><text class="title">常用品类</text><view class="chips"><text wx:for="{{profile.categories}}" wx:key="name">{{item.name}} · {{item.count}}</text></view></view><view class="card"><text class="title">常见组合</text><view class="chips"><text wx:for="{{profile.combinations}}" wx:key="name">{{item.name}} · {{item.count}}</text></view></view><view class="card"><text class="title">主要场景、季节与风格</text><view class="chips"><text wx:for="{{profile.scenes}}" wx:key="name">{{item.name}}</text><text wx:for="{{profile.seasons}}" wx:key="name">{{item.name}} · {{item.count}}</text><text wx:for="{{profile.styles}}" wx:key="name">{{item.name}}</text></view></view><view class="card"><text class="title">高频单品</text><text wx:for="{{profile.frequentItems}}" wx:key="id" class="row">{{item.name}} · {{item.count}} 次</text></view></block></view>
