.page{padding:32rpx;background:#f8f4ff;min-height:100vh}.heading{display:block;font-size:46rpx;font-weight:700;color:#29243d}.desc{display:block;color:#7f788d;line-height:1.6;margin:12rpx 0 24rpx}.stage,.card{background:#fff;border-radius:28rpx;padding:28rpx;margin:20rpx 0}.stage{display:flex;justify-content:space-between}.count,.title{font-weight:700;color:#302846}.chips{display:flex;flex-wrap:wrap;gap:12rpx;margin-top:20rpx}.chips text{background:#f2edf9;padding:12rpx 18rpx;border-radius:999rpx}.row{display:block;padding:16rpx 0;border-bottom:1rpx solid #eee9f4}.error{color:#a65454}
