.page{min-height:100vh;padding:34rpx;background:#f8f4ff;color:#634b3b;box-sizing:border-box}.heading{display:block;font-size:46rpx;font-weight:700}.sub{display:block;margin:14rpx 0 24rpx;color:#88758a;line-height:1.7}.notice{margin-bottom:18rpx;padding:18rpx;border-radius:18rpx;background:#fff0f0;color:#a6505f}.item-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:16rpx}.cloth{padding:14rpx;border:2rpx solid transparent;border-radius:24rpx;background:#fff;text-align:center}.cloth.selected{border-color:#9b75b3;background:#faf5ff}.cloth image{width:100%;height:190rpx}.cloth text{display:block;margin-top:6rpx;font-size:24rpx}.label{display:block;margin:28rpx 0 12rpx;font-weight:700}.picker,textarea{padding:20rpx;border-radius:20rpx;background:#fff}textarea{width:100%;min-height:150rpx;box-sizing:border-box}.count{display:block;margin-top:8rpx;color:#948397;text-align:right}.primary{margin-top:24rpx;border-radius:44rpx;background:#a98abe;color:#fff}.ghost{background:transparent;color:#806386}.ghost::after{border:0}
