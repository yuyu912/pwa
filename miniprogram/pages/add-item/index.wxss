.page{min-height:100vh;padding:56rpx 32rpx;background:#fcf8f3;color:#5c4738;box-sizing:border-box}.heading{display:block;font-size:48rpx;font-weight:600}.sub{display:block;margin-top:18rpx;line-height:1.8;color:#8e7867}.upload{display:flex;flex-direction:column;align-items:center;justify-content:center;height:440rpx;margin-top:44rpx;border:3rpx dashed #d7c6e2;border-radius:32rpx;background:#fffdf9;color:#9576aa}.plus{font-size:80rpx;font-weight:200}.hint{margin-top:14rpx;font-size:24rpx;color:#b59e8c}.notice{margin-top:28rpx;padding:28rpx;border-radius:24rpx;background:#f3ede6;color:#846e5e;font-size:26rpx;line-height:1.7}.notice-title{display:block;margin-bottom:8rpx;font-weight:600;color:#6f5848}.ghost{margin-top:36rpx;border-radius:48rpx;background:transparent;color:#8c719a}
