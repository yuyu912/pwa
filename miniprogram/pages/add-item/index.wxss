.page{min-height:100vh;padding:48rpx 32rpx 80rpx;background:linear-gradient(180deg,#fbf7ff 0%,#f5effa 100%);color:#5c4738;box-sizing:border-box}.heading{display:block;font-size:46rpx;font-weight:600}.sub{display:block;margin-top:14rpx;line-height:1.7;color:#8e7867;font-size:27rpx}.budget{display:flex;align-items:center;justify-content:space-between;margin-top:28rpx;padding:24rpx 28rpx;border-radius:24rpx;background:#fffdf9;box-shadow:0 12rpx 30rpx rgba(103,78,120,.08)}.budget-warning{background:#fff8e8}.budget-critical,.budget-blocked{background:#fff0ed}.budget-title,.budget-note{display:block}.budget-title{font-weight:600}.budget-note{margin-top:6rpx;color:#9b8878;font-size:23rpx}.budget-remain{color:#9675aa;font-size:25rpx}.upload{display:flex;flex-direction:column;align-items:center;justify-content:center;height:380rpx;margin-top:28rpx;border:3rpx dashed #d7c6e2;border-radius:32rpx;background:#fffdf9;color:#9576aa;overflow:hidden}.preview{width:100%;height:100%}.plus{font-size:80rpx;font-weight:200}.hint{margin-top:14rpx;font-size:23rpx;color:#b59e8c}.stage{display:flex;justify-content:center;gap:12rpx;margin-top:18rpx;color:#876b98;font-size:25rpx}.demo-tag{padding:2rpx 12rpx;border-radius:999rpx;background:#eee2f5}.error{margin-top:18rpx;padding:20rpx 24rpx;border-radius:18rpx;background:#fff0ed;color:#a95145;font-size:25rpx;line-height:1.6}.actions{margin-top:24rpx}.primary,.ghost,.back{border-radius:999rpx;font-size:28rpx}.primary{background:#a98abc;color:#fff}.ghost{margin-top:16rpx;background:#fffdf9;color:#896d99}.form-card{margin-top:28rpx;padding:28rpx;border-radius:30rpx;background:rgba(255,253,249,.94);box-shadow:0 14rpx 34rpx rgba(91,68,109,.08)}.confirm-note{padding:20rpx;border-radius:18rpx;background:#f2eaf6;color:#7d638c;font-size:24rpx;line-height:1.7}.confirm-note text{display:block}.confirm-title{font-weight:600}.field{display:block;margin-top:24rpx;font-size:25rpx;color:#766152}.field>text{display:block;margin-bottom:10rpx;font-weight:600}.field input,.picker-value{min-height:78rpx;padding:0 22rpx;border-radius:18rpx;background:#f8f3f8;box-sizing:border-box;line-height:78rpx;color:#5c4738}.picker-value{display:flex;justify-content:space-between}.two-column{display:grid;grid-template-columns:1fr 1fr;gap:16rpx}.notice{margin-top:26rpx;padding:22rpx;border-radius:20rpx;background:#f3ede6;color:#846e5e;font-size:24rpx;line-height:1.65}.notice-title{display:block;margin-bottom:6rpx;font-weight:600;color:#6f5848}.save{margin-top:26rpx}.back{margin-top:28rpx;background:transparent;color:#8c719a}
