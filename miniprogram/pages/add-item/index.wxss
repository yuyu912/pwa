.page{min-height:100vh;padding:48rpx 32rpx 80rpx;background:linear-gradient(180deg,#fbf7ff 0%,#f5effa 100%);color:#5c4738;box-sizing:border-box}.heading{display:block;font-size:46rpx;font-weight:600}.sub{display:block;margin-top:14rpx;line-height:1.7;color:#8e7867;font-size:27rpx}.upload{display:flex;flex-direction:column;align-items:center;justify-content:center;height:380rpx;margin-top:28rpx;border:3rpx dashed #d7c6e2;border-radius:32rpx;background:#fffdf9;color:#9576aa;overflow:hidden}.preview{width:100%;height:100%}.plus{font-size:80rpx;font-weight:200}.hint{margin-top:14rpx;font-size:23rpx;color:#b59e8c}.stage{display:flex;justify-content:center;gap:12rpx;margin-top:18rpx;color:#876b98;font-size:25rpx}.demo-tag{padding:2rpx 12rpx;border-radius:999rpx;background:#eee2f5}.error{margin-top:18rpx;padding:20rpx 24rpx;border-radius:18rpx;background:#fff0ed;color:#a95145;font-size:25rpx;line-height:1.6}.actions{margin-top:24rpx}.primary,.ghost,.back{border-radius:999rpx;font-size:28rpx}.primary{background:#a98abc;color:#fff}.ghost{margin-top:16rpx;background:#fffdf9;color:#896d99}.form-card{margin-top:28rpx;padding:28rpx;border-radius:30rpx;background:rgba(255,253,249,.94);box-shadow:0 14rpx 34rpx rgba(91,68,109,.08)}.confirm-note{padding:20rpx;border-radius:18rpx;background:#f2eaf6;color:#7d638c;font-size:24rpx;line-height:1.7}.confirm-note text{display:block}.confirm-title{font-weight:600}.field{display:block;margin-top:24rpx;font-size:25rpx;color:#766152}.field>text{display:block;margin-bottom:10rpx;font-weight:600}.field input,.picker-value{min-height:78rpx;padding:0 22rpx;border-radius:18rpx;background:#f8f3f8;box-sizing:border-box;line-height:78rpx;color:#5c4738}.picker-value{display:flex;justify-content:space-between}.two-column{display:grid;grid-template-columns:1fr 1fr;gap:16rpx}.notice{margin-top:26rpx;padding:22rpx;border-radius:20rpx;background:#f3ede6;color:#846e5e;font-size:24rpx;line-height:1.65}.notice-title{display:block;margin-bottom:6rpx;font-weight:600;color:#6f5848}.save{margin-top:26rpx}.back{margin-top:28rpx;background:transparent;color:#8c719a}
.batch-card,.batch-complete{margin-top:24rpx;padding:24rpx;border-radius:26rpx;background:#fffdf9;box-shadow:0 10rpx 28rpx rgba(91,68,109,.08)}.batch-heading{display:flex;justify-content:space-between;color:#6d537d;font-size:25rpx;font-weight:600}.batch-dots{display:flex;flex-wrap:wrap;gap:12rpx;margin-top:18rpx}.batch-dot{width:48rpx;height:48rpx;border-radius:999rpx;background:#eee7f2;color:#7f7088;font-size:21rpx;line-height:48rpx;text-align:center}.batch-dot.current{box-shadow:0 0 0 4rpx #b99dca}.batch-dot-saved{background:#dff0e4;color:#4d7958}.batch-dot-skipped,.batch-dot-error{background:#f7e5e1;color:#9b5d55}.batch-dot-confirming,.batch-dot-recognizing,.batch-dot-uploading{background:#e8def1;color:#75568d}.batch-note{display:block;margin-top:16rpx;color:#928298;font-size:22rpx;line-height:1.6}.batch-complete{text-align:center}.complete-title{display:block;margin-bottom:10rpx;color:#614a70;font-size:32rpx;font-weight:700}.batch-complete .primary{margin-top:22rpx}
.entitlement{display:flex;align-items:center;justify-content:space-between;gap:18rpx;margin-top:24rpx;padding:22rpx 24rpx;border-radius:24rpx;background:#eee5f5;color:#745985}.entitlement-expired{background:#f4ece7;color:#845f50}.entitlement-title,.entitlement-note{display:block}.entitlement-title{font-size:27rpx;font-weight:700}.entitlement-note{margin-top:7rpx;font-size:21rpx;line-height:1.5}.entitlement-link{flex:0 0 auto;font-size:22rpx}.ai-progress{margin-top:18rpx;padding:22rpx 24rpx;border-radius:22rpx;background:#fffdf9;box-shadow:0 10rpx 24rpx rgba(91,68,109,.07)}.ai-progress-head{display:flex;align-items:center;justify-content:space-between;color:#6d537d;font-size:25rpx;font-weight:700}.ai-model{padding:4rpx 12rpx;border-radius:999rpx;background:#eee5f5;font-size:20rpx;font-weight:500}.ai-progress-action,.ai-progress-usage,.ai-progress-safe{display:block;margin-top:10rpx}.ai-progress-action{color:#755f50;font-size:24rpx}.ai-progress-usage{padding:12rpx 14rpx;border-radius:14rpx;background:#f3edf6;color:#775987;font-size:21rpx;line-height:1.5}.ai-progress-safe{color:#a08d80;font-size:20rpx;line-height:1.5}
.entitlement-quota{display:block;margin-top:7rpx;color:#765586;font-size:21rpx;font-weight:600;line-height:1.5}.quota-warning{color:#a95145}
.upload-active{opacity:.86}
.upload-multi-review{height:auto;min-height:380rpx;display:block}.upload-multi-review .preview{display:block;height:auto}
.photo-mode{display:flex;gap:14rpx;margin-top:22rpx}.photo-mode-button{flex:1;margin:0;border-radius:999rpx;background:#fffdf9;color:#896d99;font-size:25rpx}.photo-mode-active{background:#a98abc;color:#fff}.upload{position:relative}.garment-box{position:absolute;box-sizing:border-box;border:4rpx solid #9b75b4;border-radius:14rpx;box-shadow:0 0 0 2rpx rgba(255,255,255,.85)}.garment-box text{position:absolute;left:0;top:0;padding:4rpx 10rpx;border-radius:0 0 12rpx 0;background:#9b75b4;color:#fff;font-size:20rpx;white-space:nowrap}.garment-box-off{border-color:#b7afa9;opacity:.45}.garment-box-off text{background:#8f8782}.multi-review{margin-top:20rpx;padding:24rpx;border-radius:24rpx;background:#fffdf9;box-shadow:0 10rpx 24rpx rgba(91,68,109,.07)}.multi-review-title{display:block;color:#6d537d;font-size:27rpx;font-weight:700}.multi-options{display:flex;flex-wrap:wrap;gap:12rpx;margin-top:16rpx}.multi-option{width:auto;margin:0;padding:0 22rpx;border-radius:999rpx;background:#eee8f1;color:#75687c;font-size:23rpx}.multi-option-active{background:#a98abc;color:#fff}.multi-review-note{display:block;margin-top:16rpx;color:#8d796b;font-size:22rpx;line-height:1.6}.multi-confirm{margin-top:20rpx}.quality-warning{margin-top:18rpx;padding:20rpx 24rpx;border-radius:18rpx;background:#fff7df;color:#8b682d;font-size:24rpx;line-height:1.6}
.hanger-tools{margin-top:22rpx;padding:24rpx;border-radius:24rpx;background:#fffdf9;box-shadow:0 10rpx 24rpx rgba(91,68,109,.07)}.hanger-title{display:block;color:#6d537d;font-size:27rpx;font-weight:700}.hanger-note{display:block;margin-top:10rpx;color:#8d796b;font-size:22rpx;line-height:1.6}.hanger-action,.hanger-continue{margin-top:20rpx}.choice-row{display:grid;grid-template-columns:1fr 1fr;gap:14rpx;margin-top:20rpx}.choice{margin:0;border-radius:18rpx;background:#f3edf6;color:#775987;font-size:24rpx}.choice-active{background:#a98abc;color:#fff;box-shadow:0 0 0 3rpx rgba(126,91,148,.16)}
