<view class="page">
  <text class="heading">{{entryMode === 'candidate' ? '分析一件候选新衣' : '把一件衣物放进衣橱'}}</text>
  <text class="sub">{{entryMode === 'candidate' ? 'AI 识别后由你确认标签，再与真实衣橱和穿着记录进行比较。' : 'AI 先去除背景并生成候选标签，只有你确认后才会正式入库。'}}</text>

  <view wx:if="{{entitlement}}" class="entitlement entitlement-{{entitlement.status}}" bindtap="openPlans">
    <view><text class="entitlement-title">{{entitlement.statusText}}</text><text class="entitlement-note">{{entitlement.status === 'trialing' ? '剩余约 ' + entitlement.remainingDays + ' 天；基础抠图和手动录入长期保留' : '基础抠图和手动录入仍可使用；增强权益暂未开始收费'}}</text></view>
    <text class="entitlement-link">查看套餐 ›</text>
  </view>

  <view wx:if="{{batchItems.length > 1}}" class="batch-card">
    <view class="batch-heading"><text>批量录入</text><text>{{batchSummary.saved || 0}} / {{batchSummary.total}} 已保存</text></view>
    <view class="batch-dots"><text wx:for="{{batchItems}}" wx:key="id" class="batch-dot {{index === batchIndex ? 'current' : ''}} batch-dot-{{item.status}}">{{index + 1}}</text></view>
    <text class="batch-note">图片严格按顺序处理，当前件确认入库后才会进入下一件。</text>
  </view>

  <view wx:if="{{stage !== 'batch-complete'}}" class="upload" role="button" hover-class="upload-active" bindtap="chooseImage">
    <image wx:if="{{imagePath}}" class="preview" src="{{resultImage || imagePath}}" mode="aspectFit"/>
    <block wx:else>
      <text class="plus">＋</text>
      <text>{{entryMode === 'candidate' ? '选择候选新衣图片' : '选择 1–9 张衣物图片'}}</text>
      <text class="hint">支持拍照或相册，每张压缩后不超过 2MB</text>
    </block>
  </view>

  <view wx:if="{{stageText}}" class="stage">
    <text>{{stageText}}</text>
    <text wx:if="{{isDemo}}" class="demo-tag">演示结果</text>
  </view>
  <view wx:if="{{aiProgress}}" class="ai-progress">
    <view class="ai-progress-head"><text>{{aiProgress.providerName}}</text><text class="ai-model">{{aiProgress.modelName}}</text></view>
    <text class="ai-progress-action">{{aiProgress.actionText}}</text>
    <text wx:if="{{aiProgress.usageText}}" class="ai-progress-usage">{{aiProgress.usageText}}</text>
    <text class="ai-progress-safe">仅展示真实处理阶段，不展示密钥、内部成本或模型思考过程。</text>
  </view>
  <view wx:if="{{errorText}}" class="error">{{errorText}}</view>

  <view wx:if="{{taskId && originalCutoutUrl && (stage === 'matting-review' || manualMode)}}" class="hanger-tools">
    <text class="hanger-title">图片处理选择</text>
    <text class="hanger-note">基础抠图已完成。只有主动点击下方按钮，才会额外调用一次 AI 图片编辑。</text>
    <button wx:if="{{!hangerEditUrl}}" class="ghost hanger-action" loading="{{hangerEditBusy}}" disabled="{{hangerEditBusy}}" bindtap="removeHanger">{{hangerEditBusy ? '正在移除衣架…' : 'AI 移除衣架（可选）'}}</button>
    <view wx:else class="choice-row">
      <button class="choice {{selectedImage === 'original' ? 'choice-active' : ''}}" bindtap="previewOriginal">原抠图</button>
      <button class="choice {{selectedImage === 'hanger_edit' ? 'choice-active' : ''}}" bindtap="previewHangerEdit">衣架移除图</button>
    </view>
    <text wx:if="{{hangerEditUrl}}" class="hanger-note">当前将使用：{{selectedImage === 'hanger_edit' ? '衣架移除图' : '原抠图'}}。两张图都会保留到本次任务结束。</text>
    <button wx:if="{{stage === 'matting-review' && !manualMode}}" class="primary hanger-continue" disabled="{{hangerEditBusy}}" bindtap="continueRecognition">使用当前图片并继续识别</button>
  </view>

  <view wx:if="{{stage === 'batch-complete'}}" class="batch-complete">
    <text class="complete-title">批量录入完成</text><text>已保存 {{batchSummary.saved}} 件，跳过 {{batchSummary.skipped}} 件。</text>
    <button class="primary" bindtap="openWardrobe">查看衣橱</button>
  </view>

  <button wx:if="{{batchItems.length > 1 && stage === 'batch-item-error'}}" class="ghost" bindtap="skipBatchItem">跳过这张</button>

  <view wx:if="{{imagePath && !manualMode && (stage === 'selected' || stage === 'error' || stage === 'batch-item-error')}}" class="actions">
    <button wx:if="{{stage !== 'error' || !taskId}}" class="primary" bindtap="startRecognition">AI 智能录入</button>
    <button wx:if="{{stage === 'error' && taskId && !mattingQualityFailed}}" class="primary" bindtap="retryRecognition">重试失败阶段</button>
    <button wx:if="{{mattingQualityFailed && batchItems.length <= 1}}" class="primary" bindtap="chooseImage">重新选择图片</button>
    <button wx:if="{{entryMode !== 'candidate' && !mattingQualityFailed}}" class="ghost" bindtap="useManualMode">仅抠图，手动填写</button>
    <button wx:if="{{batchItems.length > 1 && stage === 'error'}}" class="ghost" bindtap="skipBatchItem">跳过这张</button>
  </view>

  <view wx:if="{{stage === 'confirming' || manualMode}}" class="form-card">
    <view wx:if="{{needsConfirmation.length}}" class="confirm-note">
      <text class="confirm-title">需要你重点确认</text>
      <text wx:for="{{needsConfirmation}}" wx:key="*this">· {{item}}</text>
    </view>

    <label class="field">
      <text>衣物名称</text>
      <input value="{{form.name}}" data-field="name" bindinput="onFieldInput" placeholder="例如：浅紫针织上衣"/>
    </label>
    <label class="field">
      <text>品类 *</text>
      <picker range="{{categories}}" value="{{categoryIndex}}" bindchange="onCategoryChange">
        <view class="picker-value">{{form.category || '请选择品类'}} <text>›</text></view>
      </picker>
    </label>
    <label class="field">
      <text>主色</text>
      <input value="{{form.color}}" data-field="color" bindinput="onFieldInput" placeholder="例如：浅紫"/>
    </label>

    <view class="two-column">
      <label class="field">
        <text>适穿季节</text>
        <picker range="{{seasons}}" value="{{seasonIndex}}" bindchange="onSeasonChange">
          <view class="picker-value">{{form.season || '请选择'}} <text>›</text></view>
        </picker>
      </label>
      <label class="field">
        <text>衣物厚薄</text>
        <picker range="{{thicknesses}}" value="{{thicknessIndex}}" bindchange="onThicknessChange">
          <view class="picker-value">{{form.thickness || '请选择'}} <text>›</text></view>
        </picker>
      </label>
    </view>

    <view class="two-column">
      <label class="field">
        <text>花纹</text>
        <input value="{{form.pattern}}" data-field="pattern" bindinput="onFieldInput" placeholder="纯色/条纹"/>
      </label>
      <label class="field">
        <text>材质候选</text>
        <input value="{{form.material}}" data-field="material" bindinput="onFieldInput" placeholder="请查看实物确认"/>
      </label>
    </view>

    <label class="field">
      <text>风格标签</text>
      <input value="{{form.stylesText}}" data-field="stylesText" bindinput="onFieldInput" placeholder="用逗号分隔"/>
    </label>
    <label class="field">
      <text>适用场景</text>
      <input value="{{form.scenesText}}" data-field="scenesText" bindinput="onFieldInput" placeholder="休闲、通勤、约会等"/>
    </label>
    <label class="field">
      <text>购入价格（可选）</text>
      <input type="digit" value="{{form.price}}" data-field="price" bindinput="onFieldInput" placeholder="用于计算单次穿衣成本"/>
    </label>

    <view class="notice">
      <text class="notice-title">{{manualMode ? '手动录入说明' : 'AI 结果说明'}}</text>
      <text>{{manualMode ? '本次已完成基础抠图，不调用通义千问 VL；衣物属性由你填写。' : '季节、厚薄和材质均为视觉候选，不代表真实成分或合身保证。'}}</text>
    </view>
    <button wx:if="{{manualMode}}" class="primary save" bindtap="saveManual">确认基础录入</button>
    <button wx:else class="primary save" bindtap="saveConfirmed">{{entryMode === 'candidate' ? '确认标签并生成分析' : '确认标签并入库'}}</button>
  </view>

  <button class="back" bindtap="goBack">回到首页</button>
</view>
