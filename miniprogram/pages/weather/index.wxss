.page{min-height:100vh;padding:30rpx 32rpx 70rpx;background:#f7f0e3;color:#5c4b40;box-sizing:border-box}.region-bar{display:flex;align-items:center;gap:16rpx;padding:21rpx 25rpx;border:2rpx solid #dfd0b9;border-radius:25rpx;background:#fffaf1;font-weight:600}.pin{width:18rpx;height:18rpx;border:3rpx solid #85927a;border-radius:50% 50% 50% 0;transform:rotate(-45deg)}.region-arrow{margin-left:auto;font-size:36rpx}.demo-label{margin:20rpx 0 14rpx;color:#9b8879;font-size:21rpx;text-align:center}.hero{position:relative;height:470rpx;overflow:hidden;border-radius:36rpx;background:#e8eee7;box-shadow:0 11rpx 28rpx rgba(100,78,57,.1)}.weather-art{width:100%;height:100%}.weather-reading{position:absolute;right:22rpx;bottom:22rpx;left:22rpx;padding:18rpx 22rpx;border-radius:24rpx;background:rgba(255,251,243,.92)}.temp{font-size:58rpx;font-weight:600}.condition{margin-left:18rpx;color:#72806a;font-size:29rpx}.tip{display:block;margin-top:5rpx;color:#796b5f;font-size:21rpx}.advice{color:#907e6e}.manual-toggle{display:flex;align-items:center;justify-content:space-between;margin:24rpx 0;padding:22rpx 26rpx;border:2rpx solid #decfb8;border-radius:24rpx;background:#fffaf1;color:#77665a;font-size:27rpx}.manual-panel{margin-bottom:24rpx;padding:28rpx;border:2rpx solid #d8cab6;border-radius:30rpx;background:#fffaf1}.condition-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:13rpx}.condition-option{padding:17rpx 5rpx;border:2rpx solid #e1d5c3;border-radius:18rpx;background:#fcf6ec;color:#77685d;text-align:center}.condition-option.selected{border-color:#9eaa91;background:#e9efe3;color:#66735b;font-weight:600}.temperature-label{margin-top:28rpx}.temperature-control{display:flex;align-items:center;justify-content:center;gap:38rpx}.temperature-button{width:74rpx;height:62rpx;padding:0;border:2rpx solid #d5c6b2;border-radius:20rpx;background:#fffdf8;color:#756356;font-size:35rpx;line-height:58rpx}.temperature-button::after,.restore::after{border:0}.temperature-value{min-width:150rpx;font-size:50rpx;text-align:center}.temperature-range{display:block;margin-top:12rpx;color:#a08f81;font-size:21rpx;text-align:center}.restore{margin-top:17rpx;background:transparent;color:#77876d;font-size:24rpx}.card{margin-bottom:23rpx;padding:30rpx;border:2rpx solid #e0d3c0;border-radius:29rpx;background:#fffaf1}.warning{background:#f9e9df;border-color:#ecd1c2}.label{display:block;margin-bottom:12rpx;color:#7f8e74;font-size:23rpx}.title{display:block;font-size:35rpx;font-weight:600}.body{display:block;margin-top:13rpx;color:#806f62;line-height:1.75}.item-list{display:flex;flex-wrap:wrap;gap:12rpx;margin-top:20rpx}.item-pill{padding:9rpx 17rpx;border-radius:999rpx;background:#e6ecdf;color:#69775e;font-size:24rpx}.empty{display:flex;flex-direction:column;align-items:center;padding:60rpx 0;text-align:center}.empty-art{width:100%;height:380rpx;border-radius:34rpx}.empty-title{margin-top:28rpx;font-size:40rpx;font-weight:600}.empty-copy{margin-top:15rpx;color:#826f60;line-height:1.8}.primary{margin-top:29rpx;border-radius:46rpx;background:#a4ad8e;color:#fff;font-size:29rpx}.primary::after{border:0}

/* 全站主题统一为粉红色；天气插画本身的自然色不受影响。 */
.region-bar,.manual-toggle,.manual-panel,.card{border-color:#e7cdd2}.condition,.label{color:#a76f7b}.condition-option.selected{border-color:#c98b97;background:#f1dfe2;color:#8c5963}.item-pill{background:#f1dfe2;color:#815963}.primary{background:#bd7381;color:#fff}
