.page{min-height:100vh;padding:36rpx 32rpx;background:#fbf8f3;color:#5f4a3a;box-sizing:border-box}.region-bar{display:flex;justify-content:space-between;align-items:center;padding:22rpx 26rpx;border-radius:24rpx;background:#fffdf9;box-shadow:0 8rpx 22rpx rgba(119,91,66,.08);font-weight:600}.demo-label{margin-top:22rpx;color:#a58bb4;font-size:23rpx;text-align:center}.hero{padding:52rpx 18rpx 44rpx;text-align:center}.weather{display:block;font-size:90rpx;color:#bca5cf}.temp{display:block;font-size:76rpx;font-weight:600}.condition{display:block;margin-top:12rpx;color:#957f70;font-size:32rpx}.tip{display:block;margin-top:16rpx;color:#887464;line-height:1.7}.card{margin-bottom:24rpx;padding:32rpx;border-radius:28rpx;background:#fffdf9;box-shadow:0 12rpx 30rpx rgba(119,91,66,.08)}.warning{background:#fff8f0}.label{display:block;margin-bottom:12rpx;color:#a78bb8;font-size:24rpx}.title{display:block;font-size:38rpx;font-weight:600}.body{display:block;margin-top:16rpx;color:#887464;line-height:1.8}.item-list{display:flex;flex-wrap:wrap;gap:14rpx;margin-top:22rpx}.item-pill{padding:10rpx 18rpx;border-radius:999rpx;background:#f0e8f5;color:#816794;font-size:26rpx}.empty{display:flex;flex-direction:column;align-items:center;padding:150rpx 30rpx;text-align:center}.empty-icon{font-size:100rpx;color:#b49ac7}.empty-title{margin-top:30rpx;font-size:42rpx;font-weight:600}.empty-copy{margin-top:18rpx;color:#8b7667;line-height:1.8}.primary{margin-top:32rpx;border-radius:48rpx;background:#b298c2;color:white}
