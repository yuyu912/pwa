.page{min-height:100vh;padding:48rpx 32rpx;background:#fbf8f3;color:#5f4a3a;box-sizing:border-box}.hero{padding:72rpx 0 58rpx;text-align:center}.weather{display:block;font-size:90rpx;color:#bca5cf}.temp{display:block;font-size:88rpx;font-weight:600}.condition{display:block;margin-top:12rpx;color:#957f70}.card{margin-bottom:24rpx;padding:32rpx;border-radius:28rpx;background:#fffdf9;box-shadow:0 12rpx 30rpx rgba(119,91,66,.08)}.label{display:block;margin-bottom:12rpx;color:#a78bb8;font-size:24rpx}.title{display:block;font-size:38rpx;font-weight:600}.body{display:block;margin-top:16rpx;color:#887464;line-height:1.8}.primary{margin-top:32rpx;border-radius:48rpx;background:#b298c2;color:white}
