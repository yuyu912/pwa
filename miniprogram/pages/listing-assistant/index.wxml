<view class="page listing-page">
  <view wx:if="{{loading}}" class="empty">正在读取衣物…</view>
  <view wx:elif="{{error && !item}}" class="empty">{{error}}</view>
  <block wx:else>
    <text class="eyebrow">THIRD-PARTY LISTING</text><text class="title">第三方平台发布助手</text>
    <view class="notice">这里只生成发布材料并保存状态，不会登录闲鱼、自动发布、收款或创建订单。</view>
    <view class="card form-card">
      <text class="item-name">{{item.name}}</text>
      <label><text>发布方式</text><picker range="{{modes}}" range-key="label" value="{{modeIndex}}" bindchange="onMode"><view class="picker">{{modes[modeIndex].label}}</view></picker></label>
      <label><text>成色说明 *</text><input value="{{form.condition}}" data-field="condition" bindinput="onInput" placeholder="例如：九成新，无明显污渍" maxlength="80"/></label>
      <label wx:if="{{form.mode === 'sale'}}"><text>转卖价格（元）</text><input type="digit" value="{{form.salePrice}}" data-field="salePrice" bindinput="onInput"/></label>
      <block wx:else><label><text>日租金（元）</text><input type="digit" value="{{form.dailyRent}}" data-field="dailyRent" bindinput="onInput"/></label><label><text>押金（元）</text><input type="digit" value="{{form.deposit}}" data-field="deposit" bindinput="onInput"/></label><label><text>最短租期（天）</text><input type="number" value="{{form.minDays}}" data-field="minDays" bindinput="onInput"/></label></block>
      <label><text>交付方式 *</text><input value="{{form.delivery}}" data-field="delivery" bindinput="onInput" placeholder="例如：同城当面交付或快递" maxlength="50"/></label>
      <label><text>补充说明</text><textarea value="{{form.note}}" data-field="note" bindinput="onInput" maxlength="200"/></label>
      <button class="secondary" bindtap="generate">生成/更新文案</button>
    </view>
    <view wx:if="{{generated}}" class="card result-card"><text class="result-title">{{generated.title}}</text><text class="result-content">{{generated.content}}</text><button class="primary" bindtap="copyText">复制发布文案</button><button class="secondary" bindtap="previewImage">查看并长按保存图片</button></view>
    <view class="card form-card"><text class="section-title">发布后的记录</text><label><text>平台</text><input value="{{form.platform}}" data-field="platform" bindinput="onInput" maxlength="30"/></label><label><text>商品链接（可留空）</text><input value="{{form.url}}" data-field="url" bindinput="onInput" placeholder="发布后粘贴链接" maxlength="500"/></label><label><text>状态</text><picker range="{{statuses}}" range-key="label" value="{{statusIndex}}" bindchange="onStatus"><view class="picker">{{statuses[statusIndex].label}}</view></picker></label><button class="primary" loading="{{saving}}" disabled="{{saving}}" bindtap="save">保存发布记录</button></view>
    <text wx:if="{{error}}" class="error">{{error}}</text><text wx:if="{{message}}" class="message">{{message}}</text>
  </block>
</view>
