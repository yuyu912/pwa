.listing-page{padding-bottom:70rpx}.title{display:block;margin:12rpx 0 24rpx;font-size:43rpx;font-weight:700}.notice{margin-bottom:22rpx;padding:20rpx;border-radius:18rpx;background:#f5ede6;color:#765f4d;font-size:24rpx;line-height:1.6}.form-card,.result-card{display:flex;flex-direction:column;gap:18rpx;margin-bottom:22rpx}.item-name,.section-title,.result-title{font-size:29rpx;font-weight:700}label{display:flex;flex-direction:column;gap:9rpx;color:#947f82;font-size:24rpx}input,.picker,textarea{box-sizing:border-box;width:100%;padding:19rpx;border-radius:16rpx;background:#f7e9eb;color:#5f4b50;font-size:26rpx}textarea{min-height:130rpx}.result-content{white-space:pre-line;color:#75686b;font-size:25rpx;line-height:1.75}.error{display:block;color:#a95568}.message{display:block;color:#56805b}.action-feedback{padding:12rpx 16rpx;border-radius:14rpx;background:#f7edef;font-size:24rpx}
