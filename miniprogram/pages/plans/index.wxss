.page{min-height:100vh;padding:48rpx 32rpx 80rpx;background:linear-gradient(180deg,#fbf7ff,#f5effa);color:#5c4738;box-sizing:border-box}.heading{display:block;font-size:46rpx;font-weight:700}.sub{display:block;margin-top:14rpx;color:#8e7867;font-size:26rpx;line-height:1.7}.status{margin-top:26rpx;padding:24rpx 26rpx;border-radius:26rpx;background:#eee5f6;color:#705582}.status-expired{background:#f4ebe6;color:#805d4e}.status-title,.status-note{display:block}.status-title{font-size:28rpx;font-weight:700}.status-note{margin-top:8rpx;font-size:22rpx;line-height:1.5}.empty{margin-top:28rpx;padding:36rpx;border-radius:26rpx;background:#fffdf9;color:#8e7867;text-align:center}.error{color:#a95145}.retry{margin-top:18rpx;border-radius:999rpx;background:#a98abc;color:#fff;font-size:25rpx}.plan-list{display:flex;flex-direction:column;gap:20rpx;margin-top:28rpx}.plan-card{padding:28rpx;border:2rpx solid transparent;border-radius:30rpx;background:#fffdf9;box-shadow:0 12rpx 30rpx rgba(103,78,120,.08)}.plan-card.featured{border-color:#b79ac9;background:linear-gradient(135deg,#f1e8f7,#fffdf9)}.plan-head{display:flex;align-items:center;justify-content:space-between}.plan-name{font-size:32rpx;font-weight:700}.recommended{padding:5rpx 15rpx;border-radius:999rpx;background:#a98abc;color:#fff;font-size:20rpx}.duration,.price{display:block}.duration{margin-top:10rpx;color:#8e7867;font-size:23rpx}.price-row{display:flex;align-items:baseline;gap:8rpx;margin-top:20rpx}.price{color:#80618f;font-size:38rpx;font-weight:700}.price-unit{color:#9a879f;font-size:21rpx}.renewal-row{display:flex;align-items:center;justify-content:space-between;margin-top:12rpx;padding:14rpx 18rpx;border-radius:18rpx;background:#f2eaf6}.renewal-label{color:#76568b;font-size:23rpx}.renewal-price{color:#8b5c99;font-size:28rpx;font-weight:700}.purchase{margin-top:22rpx;border-radius:999rpx;background:#d8cbdc!important;color:#fff!important;font-size:26rpx}.rules{display:flex;flex-direction:column;gap:9rpx;margin-top:28rpx;padding:24rpx;border-radius:24rpx;background:#f2ece6;color:#806c5e;font-size:22rpx;line-height:1.5}.rules-title{font-size:26rpx;font-weight:700}.back{margin-top:28rpx;border-radius:999rpx;background:transparent;color:#8c719a;font-size:27rpx}
.quota-summary{display:flex;flex-direction:column;gap:7rpx;margin-top:16rpx;padding-top:14rpx;border-top:1rpx solid rgba(112,85,130,.18);font-size:22rpx;line-height:1.5}.quota-observe{color:#9b7b5e}.plan-quota{display:block;margin-top:14rpx;color:#7d6888;font-size:22rpx;line-height:1.6}
