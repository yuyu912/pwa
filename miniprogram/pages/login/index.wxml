<view class="page login-page">
  <view class="hero">
    <text class="eyebrow">Wardrobloom</text>
    <text class="title">从真实衣橱开始，
理性地决定下一件衣服。</text>
    <text class="muted">{{sharedToken ? '这是一次私密搭配邀请。登录或创建账号后即可查看和回复。' : (mode === 'register' ? '创建你的私人衣橱账号。' : '登录你的私人衣橱。')}}</text>
  </view>

  <view class="card form-card">
    <text class="label">用户名</text>
    <input value="{{username}}" bindinput="onUsername" placeholder="2—30 个字符" maxlength="30" />
    <text class="label">密码</text>
    <input password value="{{password}}" bindinput="onPassword" placeholder="{{mode === 'register' ? '至少 8 位' : '输入密码'}}" />
    <button class="primary" loading="{{loading}}" bindtap="submit">{{mode === 'register' ? '创建账号' : '登录衣橱'}}</button>
    <text class="mode-switch" bindtap="toggleMode">{{mode === 'register' ? '已有账号，去登录' : '还没有账号？创建账号'}}</text>
    <text wx:if="{{error}}" class="error">{{error}}</text>
  </view>

  <view class="contract-note">
    <text>真实联调接口：POST /api/auth/login、POST /api/auth/register</text>
    <text>认证方式：Authorization: Bearer &lt;token&gt;</text>
  </view>
</view>
