.page{min-height:100vh;padding:34rpx;background:#f8f3e8;color:#634b3b;box-sizing:border-box}.heading{display:block;font-size:46rpx;font-weight:700}.sub{display:block;margin:10rpx 0 28rpx;color:#947f82}.section-title{display:block;margin:28rpx 0 16rpx;font-size:31rpx;font-weight:700}.card{margin-bottom:20rpx;padding:24rpx;border-radius:28rpx;background:#fff}.meta,.actions{display:flex;justify-content:space-between;align-items:center}.grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12rpx;margin:18rpx 0}.grid view{padding:10rpx;border-radius:18rpx;background:#fffaf2;text-align:center}.grid image{width:100%;height:160rpx}.grid text{display:block;font-size:22rpx}.note{display:block;margin:12rpx 0;line-height:1.6}.actions{gap:16rpx}.actions button{flex:1}.approve{background:#a65e6d;color:#fff}.reject{background:#fff0f0;color:#a6505f}.secondary{margin-top:16rpx}.empty,.notice{padding:60rpx 20rpx;text-align:center;color:#947f82}.empty.small{padding:30rpx}.notice{color:#a6505f}.ghost{background:transparent;color:#8c5963}.ghost::after{border:0}
