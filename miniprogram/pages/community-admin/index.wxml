<view class="page"><text class="heading">社区审核中心</text><text class="sub">只有管理员账号可以访问</text><view wx:if="{{loading}}" class="empty">正在加载…</view><view wx:elif="{{error}}" class="notice">{{error}}</view><block wx:else><text class="section-title">待审核作品（{{posts.length}}）</text><view wx:if="{{!posts.length}}" class="empty small">暂无待审核作品</view><view wx:for="{{posts}}" wx:key="id" class="card"><view class="meta"><text>{{item.authorAlias}}</text><text>{{item.scene}}</text></view><view class="grid"><view wx:for="{{item.items}}" wx:for-item="cloth" wx:key="id"><image src="{{cloth.imageUrl}}" mode="aspectFit"/><text>{{cloth.name}}</text></view></view><text wx:if="{{item.note}}" class="note">{{item.note}}</text><view class="actions"><button class="reject" data-id="{{item.id}}" bindtap="reject">拒绝</button><button class="approve" data-id="{{item.id}}" bindtap="approve">通过</button></view></view><text class="section-title">待处理举报（{{reports.length}}）</text><view wx:if="{{!reports.length}}" class="empty small">暂无待处理举报</view><view wx:for="{{reports}}" wx:key="id" class="card"><text class="note">举报原因：{{item.reason}}</text><view wx:if="{{item.post}}" class="grid"><view wx:for="{{item.post.items}}" wx:for-item="cloth" wx:key="id"><image src="{{cloth.imageUrl}}" mode="aspectFit"/><text>{{cloth.name}}</text></view></view><text wx:else>原作品已不存在</text><button class="secondary" data-id="{{item.id}}" bindtap="resolveReport">处理举报</button></view></block><button class="ghost" bindtap="goBack">返回</button></view>
