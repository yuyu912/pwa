.page{padding:32rpx;background:#f8f3e8;min-height:100vh}.heading{display:block;font-size:46rpx;font-weight:700;color:#51413f}.desc,.footnote{display:block;color:#947f82;line-height:1.6;margin:12rpx 0 24rpx}.city{background:#fff;border-radius:999rpx}.notice,.card{background:#fff;border-radius:28rpx;padding:28rpx;margin:20rpx 0}.notice text,.card text{display:block;margin:10rpx 0}.title{font-size:30rpx;font-weight:700;color:#5f4b50}.error{display:block;color:#a65454;margin:20rpx 0}.footnote{font-size:24rpx}
