.canvas-page{min-height:100vh;padding:34rpx 28rpx 70rpx;background:#f7f0e3;color:#5c4b40;box-sizing:border-box}.page-head{display:flex;align-items:flex-start;justify-content:space-between}.eyebrow,.headline{display:block}.eyebrow{color:#879276;font-size:20rpx;letter-spacing:4rpx}.headline{margin-top:8rpx;font-size:42rpx;font-weight:700}.intro{display:block;margin:16rpx 0 24rpx;color:#88796e;font-size:23rpx;line-height:1.65}.clear-button{margin:0;padding:0 22rpx;height:60rpx;border:2rpx solid #ddcdb8;border-radius:99rpx;background:#fffaf0;color:#856f60;font-size:23rpx;line-height:56rpx}.clear-button::after,.tool-card button::after{border:0}.state-card{padding:42rpx;border:2rpx solid #ded0bb;border-radius:28rpx;background:#fffaf0;text-align:center}.state-card button{margin-top:20rpx}.error{color:#a66b62}.outfit-canvas{position:relative;width:100%;height:850rpx;overflow:hidden;border:2rpx solid #d9ccb9;border-radius:34rpx;background-color:#fffdf8;background-image:linear-gradient(rgba(189,179,163,.1) 1rpx,transparent 1rpx),linear-gradient(90deg,rgba(189,179,163,.1) 1rpx,transparent 1rpx);background-size:48rpx 48rpx;box-shadow:0 12rpx 30rpx rgba(94,72,54,.08)}.canvas-empty{position:absolute;top:50%;left:50%;display:flex;width:75%;flex-direction:column;align-items:center;gap:12rpx;color:#a99b8f;text-align:center;transform:translate(-50%,-50%)}.empty-plus{font-size:58rpx}.empty-note{font-size:20rpx;line-height:1.6}.canvas-layer{display:flex;width:190rpx;height:230rpx;align-items:center;justify-content:center;box-sizing:border-box}.canvas-layer.selected{border:3rpx dashed #9eaa88;border-radius:24rpx;background:rgba(235,240,226,.25)}.layer-image,.layer-placeholder{width:100%;height:100%;transform-origin:center}.layer-placeholder{display:flex;align-items:center;justify-content:center;border-radius:24rpx;background:#eee6d8;color:#927e6f}.selected-name{position:absolute;right:0;bottom:-36rpx;left:0;overflow:hidden;padding:4rpx 8rpx;border-radius:12rpx;background:rgba(101,91,79,.78);color:#fff;font-size:18rpx;text-align:center;text-overflow:ellipsis;white-space:nowrap}.tool-card{display:grid;grid-template-columns:repeat(5,1fr);gap:10rpx;margin-top:18rpx;padding:12rpx;border:2rpx solid #ded1bd;border-radius:26rpx;background:#fffaf1}.tool-card button{margin:0;padding:0 6rpx;height:66rpx;border-radius:18rpx;background:#e9eedf;color:#65725c;font-size:20rpx;line-height:66rpx}.tool-card .delete-tool{background:#f6e5dd;color:#9a6559}.tool-card.disabled{opacity:.55}.save-state{display:block;height:36rpx;margin-top:8rpx;color:#8c9a7b;font-size:20rpx;text-align:center}.picker-section{margin-top:18rpx;padding:24rpx;border:2rpx solid #ded0bc;border-radius:32rpx;background:#fffaf1}.picker-title-row{display:flex;align-items:center;justify-content:space-between}.picker-title{font-size:30rpx;font-weight:700}.picker-count{color:#94867a;font-size:21rpx}.category-scroll{margin-top:18rpx;white-space:nowrap}.category{display:inline-block;margin-right:12rpx;padding:9rpx 17rpx;border-radius:99rpx;background:#f1e8d9;color:#7e6c60;font-size:22rpx}.category.active{background:#a8b193;color:#fff}.item-scroll{margin-top:20rpx;white-space:nowrap}.picker-list{display:inline-flex;gap:16rpx;padding-bottom:4rpx}.picker-item{width:164rpx;white-space:normal}.picker-visual{display:flex;width:164rpx;height:176rpx;align-items:center;justify-content:center;overflow:hidden;border-radius:22rpx;background:#f3ebde;color:#978476}.picker-visual image{width:148rpx;height:160rpx}.picker-name,.picker-meta{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.picker-name{margin-top:10rpx;font-size:23rpx;font-weight:600}.picker-meta{margin-top:4rpx;color:#99897d;font-size:19rpx}.picker-empty{display:flex;width:400rpx;height:160rpx;align-items:center;justify-content:center;color:#a09285}
