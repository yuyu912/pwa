<view class="page inspiration-page">
  <view class="hero"><view class="eyebrow">PRIVATE INSPIRATION</view></view>
  <view class="tabs">
    <view class="tab {{tab === 'import' ? 'active' : ''}}" bindtap="showImport">穿搭助手</view>
    <view class="tab {{tab === 'history' ? 'active' : ''}}" bindtap="showHistory">私密历史</view>
  </view>

  <block wx:if="{{tab === 'import'}}">
    <scroll-view class="chat-scroll" scroll-y enhanced show-scrollbar="{{false}}" scroll-into-view="{{scrollIntoView}}">
      <view class="message-row {{item.role}}" id="{{item.id}}" wx:for="{{messages}}" wx:key="id">
        <view class="bubble text-bubble" wx:if="{{item.type === 'text'}}">{{item.text}}</view>
        <view class="bubble progress-bubble" wx:elif="{{item.type === 'progress'}}"><view class="progress-dot"></view>{{item.text}}</view>
        <view class="bubble state-card" wx:elif="{{item.type === 'state'}}">
          <view class="state-title">我理解的需求</view>
          <view class="state-tags"><text wx:for="{{item.tags}}" wx:key="*this">{{item}}</text></view>
        </view>

        <view class="bubble source-card" wx:elif="{{item.type === 'source'}}">
          <view class="source-platform">小红书灵感</view>
          <view class="section-title">{{item.record.sourceTitle || '我的穿搭灵感'}}</view>
          <view class="muted" wx:if="{{item.record.sourceAuthor}}">公开作者：{{item.record.sourceAuthor}}</view>
          <view class="source-link" wx:if="{{item.record.sourceUrl}}">{{item.record.sourceUrl}}</view>
          <image wx:if="{{item.record.screenshotUrl}}" src="{{item.record.screenshotUrl}}" mode="aspectFill"/>
        </view>

        <view class="bubble action-card" wx:elif="{{item.type === 'screenshot'}}">
          <view class="section-title">{{item.record.fallbackTitle}}</view>
          <view class="muted">{{item.record.fallbackNote}}</view>
          <button class="primary compact" disabled="{{busy}}" bindtap="chooseScreenshot">上传截图继续</button>
        </view>

        <view class="bubble action-card" wx:elif="{{item.type === 'confirm'}}">
          <view class="section-title">确认这一套主穿搭</view>
          <view class="muted">只修改可见标签；不会推断尺码、品牌或材质。</view>
          <view class="slot" wx:for="{{editSlots}}" wx:for-item="slot" wx:key="slot">
            <view class="slot-name">{{slot.slot === 'top' ? '上装' : slot.slot === 'bottom' ? '下装' : slot.slot === 'dress' ? '连衣裙' : '外套'}}</view>
            <view class="field"><text>品类</text><input value="{{slot.category}}" data-index="{{index}}" data-field="category" bindinput="onSlotInput"/></view>
            <view class="field"><text>颜色</text><input value="{{slot.color}}" data-index="{{index}}" data-field="color" bindinput="onSlotInput"/></view>
            <view class="field"><text>季节</text><input value="{{slot.season}}" data-index="{{index}}" data-field="season" bindinput="onSlotInput"/></view>
            <view class="field"><text>厚薄</text><input value="{{slot.thickness}}" data-index="{{index}}" data-field="thickness" bindinput="onSlotInput"/></view>
            <view class="field"><text>图案</text><input value="{{slot.pattern}}" data-index="{{index}}" data-field="pattern" bindinput="onSlotInput"/></view>
            <view class="field"><text>设计细节</text><input value="{{slot.designDetailsText}}" data-index="{{index}}" data-field="designDetailsText" bindinput="onSlotInput"/></view>
            <view class="field"><text>风格</text><input value="{{slot.stylesText}}" data-index="{{index}}" data-field="stylesText" bindinput="onSlotInput"/></view>
            <view class="field"><text>场景</text><input value="{{slot.scenesText}}" data-index="{{index}}" data-field="scenesText" bindinput="onSlotInput"/></view>
          </view>
          <button class="primary compact" loading="{{busy}}" disabled="{{busy}}" bindtap="confirmTags">确认并匹配我的衣橱</button>
        </view>

        <view class="bubble outfit-card" wx:elif="{{item.type === 'outfit'}}">
          <view class="section-title">{{item.items.length ? '这套来自你的真实衣橱' : '暂时没有完整匹配'}}</view>
          <view class="outfit-item" wx:for="{{item.items}}" wx:for-item="garment" wx:key="id">
            <image src="{{garment.imageUrl}}" mode="aspectFill"/>
            <view class="item-copy"><view class="item-name">{{garment.name}}</view><view class="muted">{{garment.category}} · {{garment.color}}</view></view>
            <view class="item-actions" wx:if="{{item.actionable}}"><text data-item-id="{{garment.id}}" catchtap="keepItem">保留</text><text data-item-id="{{garment.id}}" catchtap="replaceItem">换掉</text></view>
          </view>
          <view class="reason">{{item.reason}}</view><view class="gap" wx:if="{{item.missingText}}">还缺：{{item.missingText}}</view>
          <view class="relax-actions" wx:if="{{item.actionable && item.relaxOptions.length}}">
            <view class="relax-title">你确认后，我可以逐级放宽：</view>
            <button wx:for="{{item.relaxOptions}}" wx:for-item="option" wx:key="key" data-key="{{option.key}}" data-value="{{option.value}}" data-label="{{option.label}}" catchtap="relaxPreference">{{option.label}}</button>
          </view>
        </view>

        <view class="bubble outfit-card" wx:elif="{{item.type === 'inspiration'}}">
          <view class="section-title">按灵感匹配你的衣橱</view>
          <view class="match-group" wx:for="{{item.matches}}" wx:for-item="group" wx:key="slot">
            <view class="match-heading">{{group.inspiration.name || group.inspiration.category}}</view>
            <view class="outfit-item" wx:if="{{group.selected}}">
              <image src="{{group.selected.item.imageUrl}}" mode="aspectFill"/>
              <view class="item-copy"><view class="item-name">{{group.selected.item.name}}</view><view class="match-level {{group.selected.matchLevel}}">{{group.selected.matchLabel}}</view><view class="muted">{{group.selected.reasonsText}}</view></view>
              <view class="item-actions" wx:if="{{item.actionable}}"><text data-item-id="{{group.selected.item.id}}" catchtap="keepItem">保留</text><text data-item-id="{{group.selected.item.id}}" catchtap="replaceItem">换掉</text></view>
            </view>
            <view class="gap" wx:else>{{group.advice}}</view>
          </view>
          <view class="gap" wx:if="{{item.missingText}}">衣橱缺口：{{item.missingText}}</view>
        </view>
      </view>
      <view class="scroll-spacer"></view>
    </scroll-view>

    <view class="composer">
      <button class="attach" style="flex:0 0 64rpx;min-width:64rpx" disabled="{{busy}}" bindtap="chooseScreenshot">＋</button>
      <textarea style="flex:1 1 auto;width:auto;min-width:0" value="{{inputText}}" auto-height maxlength="1000" placeholder="发需求或粘贴小红书链接" bindinput="onInput" confirm-type="send" bindconfirm="sendMessage"/>
      <button class="send" style="flex:0 0 94rpx;min-width:94rpx" loading="{{busy}}" disabled="{{busy || !inputText}}" bindtap="sendMessage">发送</button>
    </view>
  </block>

  <block wx:else>
    <view class="empty card" wx:if="{{!history.length}}">还没有私密灵感记录</view>
    <view class="history-card card" wx:for="{{history}}" wx:key="id">
      <view class="history-main" data-id="{{item.id}}" bindtap="openHistory"><view class="history-title">{{item.sourceTitle || item.summary || '穿搭灵感'}}</view><view class="muted">{{statusText[item.status]}} · {{item.updatedAt}}</view></view>
      <view class="delete" wx:if="{{!demoReadonly}}" data-id="{{item.id}}" catchtap="deleteHistory">删除</view>
    </view>
  </block>
</view>
