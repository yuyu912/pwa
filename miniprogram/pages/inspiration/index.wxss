.inspiration-page{height:100vh;padding-bottom:calc(142rpx + env(safe-area-inset-bottom));background:#f8f3e8;color:#554b47;box-sizing:border-box;overflow:hidden}.hero{padding:18rpx 8rpx 20rpx}.eyebrow{color:#a76f7b}.tabs{display:flex;padding:8rpx;margin-bottom:12rpx;border:2rpx solid rgba(189,115,129,.28);border-radius:24rpx;background:rgba(255,252,246,.94)}.tab{flex:1;padding:16rpx;text-align:center;color:#967d7f;border-radius:18rpx}.tab.active{color:#8c5963;font-weight:600;background:#f1dfe2}.chat-scroll{height:calc(100vh - 330rpx - env(safe-area-inset-bottom));box-sizing:border-box}.message-row{display:flex;margin:16rpx 0}.message-row.user{justify-content:flex-end}.message-row.assistant{justify-content:flex-start}.bubble{max-width:86%;box-sizing:border-box;border-radius:24rpx;font-size:26rpx;line-height:1.6}.text-bubble{padding:20rpx 24rpx;background:#fffaf3;border:2rpx solid #ead4d8}.user .text-bubble{background:#bd7381;color:#fff;border-color:#bd7381;border-bottom-right-radius:8rpx}.assistant .text-bubble{border-bottom-left-radius:8rpx}.progress-bubble{display:flex;align-items:center;padding:18rpx 22rpx;background:#fffaf3;color:#88656b}.progress-dot{width:16rpx;height:16rpx;margin-right:14rpx;border-radius:50%;background:#bd7381}.source-card,.action-card,.outfit-card{width:100%;max-width:94%;padding:24rpx;background:#fffaf3;border:2rpx solid #ead4d8;box-shadow:0 10rpx 28rpx rgba(103,88,66,.06)}.source-platform{margin-bottom:8rpx;color:#a65e6d;font-size:22rpx;font-weight:600}.source-link{margin-top:10rpx;color:#8f7d78;font-size:21rpx;word-break:break-all}.source-card image{width:100%;height:320rpx;margin-top:16rpx;border-radius:18rpx}.section-title{margin-bottom:12rpx;font-size:30rpx;font-weight:650}.muted{color:#8f7d78;font-size:22rpx;line-height:1.5}.primary{background:#bd7381;color:#fff}.compact{margin-top:20rpx;font-size:25rpx}.slot{padding:18rpx 0;border-top:2rpx solid #edddda}.slot-name{margin-bottom:10rpx;color:#a76f7b;font-weight:650}.field{display:flex;a