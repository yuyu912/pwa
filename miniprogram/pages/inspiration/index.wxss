.inspiration-page { padding-bottom: 80rpx; background: #f7f2e6; color: #554b43; min-height: 100vh; box-sizing: border-box; }
.hero { padding: 18rpx 8rpx 28rpx; }
.eyebrow { color: #8c9875; }
.title { margin-top: 14rpx; font-size: 48rpx; line-height: 1.25; font-weight: 700; }
.subtitle { margin-top: 12rpx; color: #978b7d; font-size: 25rpx; }
.tabs { display: flex; padding: 8rpx; margin-bottom: 22rpx; border: 2rpx solid #ded3bf; border-radius: 24rpx; background: rgba(255,255,255,.58); }
.tab { flex: 1; padding: 18rpx; text-align: center; color: #948879; border-radius: 18rpx; }
.tab.active { color: #59634c; font-weight: 600; background: #e7ecdf; }
.card { margin-bottom: 22rpx; border: 2rpx solid #e2d6c2; background: rgba(255,253,247,.92); box-shadow: 0 10rpx 28rpx rgba(103,88,66,.06); }
.section-kicker { color: #89977b; font-size: 23rpx; }
.section-title { margin-bottom: 16rpx; font-size: 32rpx; font-weight: 650; }
textarea { box-sizing: border-box; width: 100%; height: 190rpx; padding: 22rpx; margin-bottom: 20rpx; border-radius: 20rpx; background: #f2eadc; line-height: 1.55; }
.primary, .secondary { margin-top: 18rpx; font-weight: 600; }
.primary { background: #aeb99a; color: #fff; }
.secondary { background: #eee7d8; color: #655c52; }
.divider { margin: 24rpx 0 2rpx; text-align: center; color: #aa9d8b; font-size: 23rpx; }
.privacy-note { margin-top: 20rpx; color: #9a8c7d; font-size: 23rpx; line-height: 1.65; }
.progress { display: flex; align-items: center; color: #6d775f; }
.progress-dot { width: 18rpx; height: 18rpx; margin-right: 16rpx; border-radius: 50%; background: #aeb99a; }
.error { color: #a65e58; background: #fff4ef; }
.source-row { display: flex; justify-content: space-between; align-items: center; }
.source-platform { color: #8e5b57; font-weight: 600; }
.status-pill { padding: 8rpx 14rpx; border-radius: 999rpx; background: #e9eddf; color: #6d785e; font-size: 21rpx; }
.source-title { margin-top: 18rpx; font-size: 34rpx; font-weight: 650; }
.source-author, .source-link { margin-top: 10rpx; color: #948779; font-size: 23rpx; line-height: 1.5; word-break: break-all; }
.source-image { width: 100%; height: 360rpx; margin-top: 18rpx; border-radius: 22rpx; }
.muted { color: #948779; }
.slot { padding: 22rpx 0; border-top: 2rpx solid #eee5d6; }
.slot-name { margin-bottom: 12rpx; color: #6f7b60; font-weight: 650; }
.field { display: flex; align-items: center; margin-top: 12rpx; }
.field text { width: 100rpx; color: #958879; font-size: 24rpx; }
.field input { flex: 1; height: 68rpx; padding: 0 18rpx; border-radius: 16rpx; background: #f3ecdf; }
.result-heading { margin: 34rpx 4rpx 20rpx; font-size: 38rpx; font-weight: 700; }
.match-title { font-size: 31rpx; font-weight: 650; }
.recognized { margin-top: 8rpx; color: #938678; font-size: 23rpx; }
.candidate { display: flex; margin-top: 20rpx; padding-top: 20rpx; border-top: 2rpx solid #eee5d6; }
.candidate image { width: 126rpx; height: 126rpx; border-radius: 18rpx; background: #eee8dc; }
.candidate-copy { display: flex; flex: 1; flex-direction: column; justify-content: center; margin-left: 18rpx; }
.candidate-copy text { margin-top: 6rpx; color: #8b806f; font-size: 22rpx; }
.gap { margin-top: 18rpx; padding: 20rpx; border-radius: 18rpx; background: #f7eae1; color: #8e6f60; line-height: 1.55; }
.history-card { display: flex; align-items: center; }
.history-main { flex: 1; min-width: 0; }
.history-title { margin-bottom: 10rpx; font-size: 29rpx; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.delete { padding: 18rpx 0 18rpx 28rpx; color: #a65e58; }
.new-button { margin-bottom: 26rpx; }
