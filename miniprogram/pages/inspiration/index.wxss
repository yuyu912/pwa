.inspiration-page{padding-bottom:calc(150rpx + env(safe-area-inset-bottom));background:#f8f3e8;color:#554b47;min-height:100vh;box-sizing:border-box}.hero{padding:18rpx 8rpx 28rpx}.eyebrow{color:#a76f7b}.title{margin-top:14rpx;font-size:48rpx;line-height:1.25;font-weight:700}.subtitle{margin-top:12rpx;color:#8f7d78;font-size:25rpx}.tabs{display:flex;padding:8rpx;margin-bottom:22rpx;border:2rpx solid rgba(193,126,140,.22);border-radius:24rpx;background:rgba(255,252,246,.94)}.tab{flex:1;padding:18rpx;text-align:center;color:#967d7f;border-radius:18rpx}.tab.active{color:#8c5f69;font-weight:600;background:#f3e0e2}.card{margin-bottom:22rpx;border:2rpx solid rgba(193,126,140,.22);background:rgba(255,252,246,.94);box-shadow:0 10rpx 28rpx rgba(103,88,66,.06)}.section-kicker{color:#a76f7b;font-size:23rpx}.section-title{margin-bottom:16rpx;font-size:32rpx;font-weight:650}textarea{box-sizing:border-box;width:100%;height:190rpx;padding:22rpx;margin-bottom:20rpx;border-radius:20rpx;background:#f6e9e7;line-height:1.55}.primary,.secondary{margin-top:18rpx;font-weight:600}.primary{background:#c9828f;color:#fff}.secondary{background:#f2e2e2;color:#815d65}.divider{margin:24rpx 0 2rpx;text-align:center;color:#8f7d78;font-size:23rpx}.privacy-note{margin-top:20rpx;color:#8f7d78;font-size:23rpx;line-height:1.65}.progress{display:flex;align-items:center;color:#88656b}.progress-dot{width:18rpx;height:18rpx;margin-right:16rpx;border-radius:50%;background:#c9828f}.error{color:#a65e58;background:#fff4ef}.source-row{display:flex;justify-content:space-between;align-items:center}.source-platform{color:#a45f6c;font-weight:600}.status-pill{padding:8rpx 14rpx;border-radius:999rpx;background:#f3e0e2;color:#8c5f69;font-size:21rpx}.source-title{margin-top:18rpx;font-size:34rpx;font-weight:650}.source-author,.source-link{margin-top:10rpx;color:#8f7d78;font-size:23rpx;line-height:1.5;word-break:break-all}.source-image{width:100%;height:360rpx;margin-top:18rpx;border-radius:22rpx}.muted{color:#8f7d78}.slot{padding:22rpx 0;border-top:2rpx solid #edddda}.slot-name{margin-bottom:12rpx;color:#a76f7b;font-weight:650}.field{display:flex;align-items:center;margin-top:12rpx}.field text{width:100rpx;color:#8f7d78;font-size:24rpx}.field input{flex:1;height:68rpx;padding:0 18rpx;border-radius:16rpx;background:#f6e9e7}.result-heading{margin:34rpx 4rpx 20rpx;font-size:38rpx;font-weight:700}.match-title{font-size:31rpx;font-weight:650}.recognized{margin-top:8rpx;color:#8f7d78;font-size:23rpx}.match-advice{margin-top:14rpx;padding:16rpx;border-radius:14rpx;background:#f6e9e7;color:#756959;font-size:23rpx;line-height:1.55}.candidate{display:flex;margin-top:20rpx;padding-top:20rpx;border-top:2rpx solid #edddda}.candidate image{width:126rpx;height:126rpx;border-radius:18rpx;background:#f2e7e2}.candidate-copy{display:flex;flex:1;flex-direction:column;justify-content:center;margin-left:18rpx}.candidate-copy text{margin-top:6rpx;color:#8b806f;font-size:22rpx}.match-level{align-self:flex-start;padding:4rpx 10rpx;border-radius:99rpx;background:#e7eddf;color:#68745f;font-size:19rpx}.match-level.style_alternative{background:#f3e0e2;color:#8c5f69}.match-level.coordinated_alternative{background:#f5ead8;color:#8c7258}.gap{margin-top:18rpx;padding:20rpx;border-radius:18rpx;background:#f8e8e3;color:#8d665f;line-height:1.55}.history-card{display:flex;align-items:center}.history-main{flex:1;min-width:0}.history-title{margin-bottom:10rpx;font-size:29rpx;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.delete{padding:18rpx 0 18rpx 28rpx;color:#a65e58}.new-button{margin-bottom:26rpx}
