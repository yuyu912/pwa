.page{min-height:100vh;padding:76rpx 42rpx;background:#faf6fb;color:#5b4663;text-align:center;box-sizing:border-box}.art{width:176rpx;height:176rpx;margin:0 auto 34rpx;border-radius:50%;background:#eee3f4;color:#a98dbc;font-size:98rpx;line-height:176rpx}.heading{display:block;font-size:48rpx;font-weight:600}.sub{display:block;margin-top:22rpx;line-height:1.9;color:#856f8d;text-align:left}.privacy{margin-top:40rpx;padding:28rpx;border-radius:26rpx;background:#fffdfb;color:#876f80;text-align:left;line-height:1.75;font-size:27rpx}.privacy-title{display:block;margin-bottom:10rpx;color:#71566e;font-weight:600}.primary,.ghost{margin-top:30rpx;border-radius:48rpx}.primary{background:#a88cbb;color:white}.ghost{margin-top:16rpx;background:transparent;color:#92759d}
