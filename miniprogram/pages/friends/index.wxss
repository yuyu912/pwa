.home-link{margin:0 0 12rpx auto;padding:0;background:transparent;color:#9b6671;font-size:27rpx;line-height:1.8}.home-link::after{border:0}.head{margin:22rpx 0 30rpx}.heading{display:block;font-size:46rpx;font-weight:600;margin:12rpx 0}.sub,.muted{display:block;color:#947f82;font-size:27rpx;line-height:1.7}.notice{margin:22rpx 0;padding:22rpx;border-radius:20rpx;background:#f1dfe2;color:#71566e;font-size:27rpx;line-height:1.6}.notice.error{background:#fff0f1;color:#a95568}.notice.success{background:#edf7ef;color:#497257}.privacy-title,.label{display:block;color:#71566e;font-weight:600;margin-bottom:12rpx}.privacy{line-height:1.75;margin-bottom:26rpx}.item-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:18rpx;margin:18rpx 0 28rpx}.choose-item,.shared-item{min-height:250rpx;padding:16rpx;border:2rpx solid #ead4d8;border-radius:24rpx;background:#fff;text-align:center;box-sizing:border-box}.choose-item.picked{border-color:#c98b97;background:#fffaf2}.choose-item image,.shared-item image{width:100%;height:170rpx}.choose-item text,.shared-item text{display:block;font-size:25rpx;color:#71566e;margin-top:5rpx}.card{margin:22rpx 0}.question{display:block;font-size:31rpx;line-height:1.6}.verdicts{display:flex;gap:14rpx;margin:14rpx 0 20rpx}.verdict{padding:12rpx 18rpx;border-radius:999rpx;background:#f1dfe2;color:#815963;font-size:26rpx}.verdict.selected{background:#bd7381;color:#fff}textarea{width:100%;min-height:150rpx;box-sizing:border-box;padding:18rpx;border-radius:18rpx;background:#fffaf2;font-size:28rpx;line-height:1.5;margin:12rpx 0 20rpx}input{width:100%;box-sizing:border-box;padding:20rpx;border-radius:18rpx;background:#fffaf2;font-size:27rpx;margin:12rpx 0}.primary,.secondary,.ghost{margin-top:18rpx}.ghost{display:block;background:transparent;color:#9b6671}.summary{display:block;margin:10rpx 0 16rpx;color:#8c5963}.reply{padding:18rpx 0;border-top:1rpx solid #ead4d8;line-height:1.6}.link{display:block;margin:10rpx 0 0;background:transparent;color:#9b7181;font-size:23rpx;text-align:left}.empty{text-align:center;padding:70rpx 10rpx;color:#947f82}.restore-input{height:92rpx;border:2rpx solid #d6aab2;background:#fff;color:#5f4b50}.restore-card .secondary,.restore-card .primary{width:100%}
