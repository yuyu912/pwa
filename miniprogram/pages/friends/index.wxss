.head{margin:22rpx 0 30rpx}.heading{display:block;font-size:46rpx;font-weight:600;margin:12rpx 0}.sub,.muted{display:block;color:#856f8d;font-size:27rpx;line-height:1.7}.notice{margin:22rpx 0;padding:22rpx;border-radius:20rpx;background:#f0e8f7;color:#71566e;font-size:27rpx;line-height:1.6}.notice.error{background:#fff0f1;color:#a95568}.notice.success{background:#edf7ef;color:#497257}.privacy-title,.label{display:block;color:#71566e;font-weight:600;margin-bottom:12rpx}.privacy{line-height:1.75;margin-bottom:26rpx}.item-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:18rpx;margin:18rpx 0 28rpx}.choose-item,.shared-item{min-height:250rpx;padding:16rpx;border:2rpx solid #ece1f2;border-radius:24rpx;background:#fff;text-align:center;box-sizing:border-box}.choose-item.picked{border-color:#9574b8;background:#faf5ff}.choose-item image,.shared-item image{width:100%;height:170rpx}.choose-item text,.shared-item text{display:block;font-size:25rpx;color:#71566e;margin-top:5rpx}.card{margin:22rpx 0}.question{display:block;font-size:31rpx;line-height:1.6}.verdicts{display:flex;gap:14rpx;margin:14rpx 0 20rpx}.verdict{padding:12rpx 18rpx;border-radius:999rpx;background:#f0e8f7;color:#725980;font-size:26rpx}.verdict.selected{background:#8d6bad;color:#fff}textarea{width:100%;min-height:150rpx;box-sizing:border-box;padding:18rpx;border-radius:18rpx;background:#faf7fb;font-size:28rpx;line-height:1.5;margin:12rpx 0 20rpx}input{width:100%;box-sizing:border-box;padding:20rpx;border-radius:18rpx;background:#faf7fb;font-size:27rpx;margin:12rpx 0}.primary,.secondary,.ghost{margin-top:18rpx}.ghost{display:block;background:transparent;color:#82628f}.summary{display:block;margin:10rpx 0 16rpx;color:#78549b}.reply{padding:18rpx 0;border-top:1rpx solid #eee5f2;line-height:1.6}.link{display:block;margin:10rpx 0 0;background:transparent;color:#9b7181;font-size:23rpx;text-align:left}.empty{text-align:center;padding:70rpx 10rpx;color:#8b8298}.restore-input{height:92rpx;border:2rpx solid #b79acb;background:#fff;color:#33294a}.restore-card .secondary,.restore-card .primary{width:100%}
