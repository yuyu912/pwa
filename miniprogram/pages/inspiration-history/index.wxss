.history-page{min-height:100vh;padding:36rpx 30rpx;background:#f8f3e8;color:#554b47;box-sizing:border-box}.heading{font-size:46rpx;font-weight:700}.desc,.muted{margin-top:10rpx;color:#8f7d78;font-size:23rpx}.card{margin-top:22rpx;padding:24rpx;border:2rpx solid rgba(193,126,140,.22);border-radius:26rpx;background:#fffaf4}.history-card{display:flex;align-items:center}.history-main{min-width:0;flex:1}.title{font-size:29rpx;font-weight:650}.delete{padding:20rpx 0 20rpx 26rpx;color:#a65e58}.error{color:#a65e58;background:#fff0eb}.ghost{margin:20rpx 0 0;background:transparent;color:#956773;text-align:left}.ghost::after{border:0}.advice{margin-top:14rpx;line-height:1.6}.candidate{display:flex;gap:16rpx;margin-top:18rpx;padding-top:18rpx;border-top:2rpx solid #edddda}.candidate image{width:112rpx;height:112rpx;border-radius:16rpx}.candidate>view{display:flex;flex:1;flex-direction:column;justify-content:center}.level{align-self:flex-start;margin-top:7rpx;padding:4rpx 10rpx;border-radius:99rpx;background:#f3e0e2;color:#8c5f69;font-size:19rpx}
