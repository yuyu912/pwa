<view class="page"><text class="eyebrow">REPORT &amp; FEEDBACK</text><text class="title">投诉与反馈</text><view class="card"><text class="label">问题类型</text><picker mode="selector" range="{{categories}}" value="{{categoryIndex}}" bindchange="onCategoryChange"><view class="picker">{{categories[categoryIndex]}} ›</view></picker><text class="label">问题说明</text><textarea value="{{detail}}" bindinput="onDetail" maxlength="500" placeholder="请说明发生了什么（5—500 字）"/><text class="count">{{detail.length}} / 500</text><text class="label">联系方式（选填）</text><input value="{{contact}}" bindinput="onContact" maxlength="80" placeholder="便于处理人员联系你"/><button class="primary" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submit">提交</button><text wx:if="{{message}}" class="success">{{message}}</text><text wx:if="{{error}}" class="error">{{error}}</text></view></view>
