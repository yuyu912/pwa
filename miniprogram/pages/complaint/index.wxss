.title{display:block;font-size:46rpx;font-weight:600;margin:12rpx 0 28rpx}.card{line-height:1.7}.label{display:block;color:#71566e;font-weight:600;margin:18rpx 0 10rpx}.picker,input,textarea{width:100%;box-sizing:border-box;padding:20rpx;border:2rpx solid #ead4d8;border-radius:18rpx;background:#fff;color:#5f4b50;font-size:27rpx}.picker{min-height:84rpx}textarea{min-height:220rpx}.count{display:block;text-align:right;color:#947f82;font-size:23rpx}.primary{margin-top:26rpx}.success,.error{display:block;margin-top:18rpx}.success{color:#497257}.error{color:#a95568}
