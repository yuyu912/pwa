.detail-hero { display: flex; align-items: center; gap: 22rpx; }
.detail-visual { width: 170rpx; height: 170rpx; flex: 0 0 auto; overflow: hidden; border-radius: 26rpx; }
.detail-image { width: 100%; height: 100%; background: #fffdf9; }
.detail-summary { display: flex; flex: 1; flex-direction: column; min-width: 0; }
.detail-title { display: block; margin: 8rpx 0; font-size: 37rpx; font-weight: 700; }
.section { display: flex; flex-direction: column; gap: 18rpx; margin-top: 22rpx; }
.section-title { font-size: 30rpx; font-weight: 700; }
.attribute-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14rpx; }
.attribute { display: flex; flex-direction: column; gap: 6rpx; padding: 16rpx; border-radius: 16rpx; background: #f7edef; color: #5f4b50; font-size: 26rpx; }
.attribute-label { color: #968a9f; font-size: 22rpx; }
.tags { display: flex; flex-wrap: wrap; gap: 10rpx; }
.tag { padding: 7rpx 14rpx; border-radius: 999rpx; background: #f1dfe2; color: #8c5963; font-size: 23rpx; }
.style-tag { background: #f8eef1; color: #956877; }
.field-label { color: #947f82; font-size: 24rpx; }
.picker, textarea { padding: 20rpx; background: #f7e9eb; border-radius: 16rpx; color: #79575d; font-size: 27rpx; }
textarea { box-sizing: border-box; width: 100%; min-height: 150rpx; }
.message { color: #56805b; font-size: 25rpx; }
.history-list { display: flex; flex-direction: column; gap: 14rpx; }
.history-item { display: flex; flex-direction: column; gap: 8rpx; padding: 18rpx; border-radius: 18rpx; background: #f7edef; }
.history-top { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.history-date { color: #5f4b50; font-size: 26rpx; font-weight: 600; }
.history-scene { padding: 5rpx 12rpx; border-radius: 999rpx; background: #f1dfe2; color: #8c5963; font-size: 22rpx; }
.history-comfort, .history-note { color: #947f82; font-size: 24rpx; }
.field { display: flex; flex-direction: column; gap: 10rpx; color: #947f82; font-size: 24rpx; }
.field input { box-sizing: border-box; width: 100%; padding: 20rpx; border-radius: 16rpx; background: #f7e9eb; color: #5f4b50; font-size: 27rpx; }
.edit-columns, .edit-actions, .management-actions { display: flex; gap: 16rpx; }
.edit-columns .field, .edit-actions button, .management-actions button { flex: 1; min-width: 0; }
.management-actions { margin-top: 22rpx; }
.delete-button { background: #fff4f3; color: #9a6670; }
.idle-status { align-self: flex-start; margin-bottom: 6rpx; padding: 6rpx 12rpx; border-radius: 999rpx; background: #f5e9df; color: #95694c; font-size: 21rpx; }.idle-current { display: flex; flex-direction: column; gap: 8rpx; padding: 18rpx; border-radius: 18rpx; background: #fbf4ed; color: #765e4d; font-size: 24rpx; line-height: 1.55; }.idle-button { background: #ad866c; color: #fff; }.idle-message { padding: 12rpx 16rpx; border-radius: 14rpx; background: #eef5ed; color: #57745a; font-size: 23rpx; }
