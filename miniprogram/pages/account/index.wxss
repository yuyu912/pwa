.account-page{min-height:100vh;padding-bottom:80rpx;background:linear-gradient(180deg,#f8f3e8,#f7ebe9)}.eyebrow{color:#ad7782}.title{display:block;margin:10rpx 0 28rpx;font-size:52rpx;font-weight:700}.card{margin-bottom:20rpx;border-color:rgba(193,126,140,.18);background:#fffaf2;line-height:1.8;color:#69585a}.heading{display:block;margin-bottom:8rpx;color:#79575d;font-weight:700}.profile-card{display:flex;align-items:center;gap:22rpx}.avatar{display:flex;width:92rpx;height:92rpx;align-items:center;justify-content:center;border-radius:50%;background:#f1dfe1;color:#9b6671;font-size:38rpx;font-weight:700}.username,.profile-note{display:block}.username{font-size:34rpx;font-weight:700}.profile-note,.section-note{color:#947f82;font-size:23rpx}.entitlement-card{background:linear-gradient(135deg,#f3e1e3,#fffaf2)}.section-head{display:flex;align-items:flex-start;justify-content:space-between}.plan-link{color:#a76774;font-size:24rpx}.quota-grid{display:flex;gap:16rpx;margin:22rpx 0}.quota-item{flex:1;padding:20rpx;border-radius:22rpx;background:rgba(255,255,255,.72);text-align:center}.quota-item text{display:block;font-size:22rpx}.quota-number{color:#a96875;font-size:38rpx!important;font-weight:700}.settings-card .heading{margin-bottom:14rpx}.row-button{margin:0;padding:20rpx 4rpx;border-bottom:1rpx solid #eededd;border-radius:0;background:transparent;color:#69585a;text-align:left}.row-button::after{border:0}.logout-button{margin:28rpx 0;border:2rpx solid #d6aab2;background:#fffaf4;color:#9b6671}.danger{background:#fff8f8}.danger-button{margin-top:20rpx;background:#b85d6d;color:#fff}.error{display:block;margin-top:14rpx;color:#a95568}.state-card{margin-top:120rpx;padding:48rpx 30rpx;border-radius:28rpx;background:#fffaf2;text-align:center;box-shadow:0 10rpx 30rpx rgba(110,74,78,.08)}.state-title{display:block;font-size:34rpx;font-weight:600}.state-copy{display:block;margin:18rpx 0;color:#907d80;line-height:1.7}.state-card .primary{margin-top:24rpx;background:#c9828f}.admin-card{background:linear-gradient(120deg,#f3e1e3,#fffaf2)}
