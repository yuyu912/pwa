.page{min-height:100vh;padding:32rpx;background:#f8f3e8;color:#634b3b;box-sizing:border-box}.heading{display:block;font-size:46rpx;font-weight:700}.sub{display:block;margin:12rpx 0 22rpx;color:#947f82;line-height:1.6}.primary{border-radius:44rpx;background:#bd7381;color:#fff}.tabs{display:flex;margin:28rpx 0 22rpx;padding:8rpx;border-radius:999rpx;background:#f1dfe2}.tab{flex:1;padding:15rpx 8rpx;border-radius:999rpx;text-align:center;color:#8c5963}.tab.active{background:#fff;color:#8c5963;font-weight:700}.post-card{margin-bottom:24rpx;padding:26rpx;border-radius:30rpx;background:#fff;box-shadow:0 10rpx 28rpx rgba(100,72,89,.08)}.post-head,.actions{display:flex;align-items:center;justify-content:space-between}.post-head{font-weight:700}.scene{padding:7rpx 16rpx;border-radius:999rpx;background:#f1dfe2;color:#8c5963;font-size:23rpx}.item-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14rpx;margin:20rpx 0}.cloth{padding:12rpx;border-radius:20rpx;background:#fffaf2;text-align:center}.cloth image{width:100%;height:180rpx}.cloth text{display:block;overflow:hidden;font-size:23rpx;white-space:nowrap;text-overflow:ellipsis}.note{display:block;margin:12rpx 0;color:#765f6c;line-height:1.6}.status{display:inline-block;margin:8rpx 0;padding:7rpx 14rpx;border-radius:999rpx;background:#f4e9eb;color:#8c5963;font-size:22rpx}.status-approved{background:#eaf6ed;color:#477250}.status-rejected{background:#fff0f0;color:#a6505f}.actions{margin-top:18rpx}.like,.link{margin:0;padding:0;background:transparent;color:#9b6671;font-size:25rpx}.like.liked{color:#ad5877;font-weight:700}.like::after,.link::after,.ghost::after{border:0}.empty,.notice{padding:80rpx 20rpx;text-align:center;color:#947f82}.notice.error{color:#a6505f}.ghost{background:transparent;color:#8c5963}
