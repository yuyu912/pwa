<view class="page privacy-page">
  <view class="eyebrow">PRIVACY NOTICE</view>
  <view class="title">隐私保护说明</view>

  <view wx:for="{{sections}}" wx:key="title" class="card privacy-card">
    <view class="heading">{{item.title}}</view>
    <view class="content">{{item.content}}</view>
  </view>

  <button class="secondary" bindtap="goBack">返回</button>
</view>
