.page{min-height:100vh;padding:52rpx 32rpx;background:#f8f5fb;color:#55425f;box-sizing:border-box}.eyebrow{display:block;color:#a58bb4;font-size:24rpx}.heading{display:block;margin-top:10rpx;font-size:50rpx;font-weight:600}.intro{display:block;margin:18rpx 0 28rpx;color:#806e86;line-height:1.75}.scene-field{display:flex;align-items:center;justify-content:space-between;padding:22rpx 26rpx;border-radius:24rpx;background:#fffdfa}.scene-picker{min-width:150rpx;text-align:right;color:#8062a3;font-weight:600}.state{display:block;margin-top:34rpx;text-align:center;color:#806e86}.error{color:#a16868}.summary-card{display:flex;gap:12rpx;margin-top:28rpx;padding:26rpx 18rpx;border-radius:28rpx;background:#fffdfa}.summary-card view{min-width:0;flex:1;text-align:center}.summary-number,.summary-label{display:block}.summary-number{color:#8062a3;font-size:42rpx;font-weight:700}.summary-label{margin-top:6rpx;color:#907f96;font-size:22rpx}.coverage{display:block;margin:20rpx 0;padding:18rpx 22rpx;border-radius:20rpx;background:#fff3e7;color:#9a6d48}.coverage.ready{background:#eaf6ef;color:#4d8063}.item-list{display:flex;flex-direction:column;gap:16rpx}.item-card{display:flex;gap:22rpx;padding:20rpx;border-radius:26rpx;background:#fffdfa}.item-card image{flex:0 0 auto;width:150rpx;height:170rpx;border-radius:18rpx;background:#f2ebf6}.item-copy{display:flex;min-width:0;flex:1;flex-direction:column;justify-content:center}.item-name{font-size:31rpx;font-weight:600}.item-meta{margin-top:8rpx;color:#917f97;font-size:24rpx}.item-reason{margin-top:12rpx;color:#806e86;font-size:23rpx;line-height:1.55}.gap-card,.optional-card{margin-top:20rpx;padding:22rpx;border-radius:22rpx;line-height:1.65}.gap-card{background:#fff0ed;color:#9b5e57}.gap-title{display:block;font-weight:600}.optional-card{background:#f1ebf7;color:#806e86}.primary,.secondary,.ghost{margin-top:26rpx;border-radius:48rpx}.primary{background:#a88ebb;color:#fff}.secondary{background:#eee5f6;color:#8062a3}.ghost{background:transparent;color:#8c7496}
