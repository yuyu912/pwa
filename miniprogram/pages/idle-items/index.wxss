.idle-page{padding-bottom:70rpx}.page-title{display:block;margin:10rpx 0 8rpx;color:#5f4b50;font-size:48rpx;font-weight:700}.privacy-note{margin-top:22rpx;padding:20rpx 24rpx;border-radius:20rpx;background:#f6eee7;color:#7c624f;font-size:23rpx;line-height:1.6}.retry{margin-top:20rpx}.empty-card{margin-top:25rpx;text-align:center}.empty-title{display:block;margin-bottom:10rpx;color:#69585a;font-size:29rpx;font-weight:700}.idle-list{display:flex;flex-direction:column;gap:18rpx;margin-top:25rpx}.idle-item{display:flex;align-items:flex-start;gap:20rpx;padding:20rpx}.item-image,.item-placeholder{flex:0 0 auto;width:116rpx;height:116rpx;border-radius:22rpx}.item-placeholder{background:#f1dfe2;color:#a76f7b;font-size:38rpx;line-height:116rpx;text-align:center}.item-copy{display:flex;min-width:0;flex:1;flex-direction:column;gap:7rpx}.item-name{color:#5f4b50;font-size:29rpx;font-weight:700}.reason{color:#87634c;font-size:23rpx}.note{padding:10rpx 13rpx;border-radius:13rpx;background:#fbf3ec;color:#776354;font-size:22rpx;line-height:1.5}.meta{color:#947f82;font-size:21rpx;line-height:1.5}.restore-button{margin:8rpx 0 0;padding:0 22rpx;background:#f1dfe2;color:#815963;font-size:23rpx;line-height:64rpx}
