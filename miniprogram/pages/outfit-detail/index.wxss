.detail-page{min-height:100vh;padding:34rpx 28rpx 70rpx;background:#f7f0e3;color:#5c4b40;box-sizing:border-box}.eyebrow,.headline,.saved-date{display:block}.eyebrow{color:#879276;font-size:20rpx;letter-spacing:4rpx}.headline{margin-top:8rpx;font-size:42rpx;font-weight:700;line-height:1.35}.saved-date{margin-top:10rpx;color:#99897d;font-size:22rpx}.state-card{display:flex;min-height:360rpx;align-items:center;justify-content:center;flex-direction:column;padding:38rpx;border:2rpx solid #ded0bb;border-radius:28rpx;background:#fffaf0;color:#8d7c70;text-align:center;box-sizing:border-box}.error-state{color:#a66b62}.error-actions{display:flex;gap:14rpx;margin-top:24rpx}.error-actions button{margin:0;background:#9ca987;color:#fff;font-size:22rpx}.error-actions .secondary-button{background:#eee6d8;color:#725f52}.outfit-display{position:relative;height:820rpx;overflow:hidden;margin-top:26rpx;border:2rpx solid #dfd1bd;border-radius:32rpx;background-color:#fffdf8;background-image:linear-gradient(rgba(189,179,163,.08) 1rpx,transparent 1rpx),linear-gradient(90deg,rgba(189,179,163,.08) 1rpx,transparent 1rpx);background-size:46rpx 46rpx;box-shadow:0 12rpx 28rpx rgba(94,72,54,.08)}.display-layer{position:absolute;display:flex;align-items:center;justify-content:center;transform-origin:center}.display-layer image{width:100%;height:100%}.image-placeholder,.garment-placeholder{display:flex;width:100%;height:100%;align-items:center;justify-content:center;background:#eee6d8;color:#927e6f}.image-placeholder{border-radius:22rpx;font-size:20rpx}.garment-section{margin-top:22rpx;padding:26rpx;border:2rpx solid #ded0bc;border-radius:30rpx;background:#fffaf1}.section-head{display:flex;align-items:center;justify-content:space-between}.section-title{font-size:29rpx;font-weight:700}.section-count{color:#99897d;font-size:21rpx}.garment-row{display:flex;align-items:center;margin-top:18rpx;padding:14rpx;border-radius:22rpx;background:#f5ecde}.garment-image-wrap{width:104rpx;height:104rpx;overflow:hidden;border-radius:18rpx;background:#fffdf8}.garment-image{width:100%;height:100%}.garment-placeholder{font-size:19rpx}.garment-copy{display:flex;min-width:0;flex:1;flex-direction:column;gap:8rpx;margin-left:18rpx}.garment-name{overflow:hidden;font-size:25rpx;font-weight:700;text-overflow:ellipsis;white-space:nowrap}.garment-meta{color:#97877b;font-size:21rpx}
.wear-record-meta{display:flex;flex-direction:column;gap:7rpx;margin-top:16rpx;padding:16rpx 19rpx;border-radius:25rpx 18rpx 27rpx 20rpx;background:#f1dfe2;color:#77658e;font-size:21rpx;line-height:1.55}
