<view class="page">
  <view wx:if="{{loading}}" class="empty">正在使用已确认标签与衣橱记录进行规则比较…</view>
  <view wx:elif="{{error}}" class="empty"><text>{{error}}</text><button class="secondary retry" bindtap="load">重新尝试</button></view>
  <block wx:else>
    <view class="card candidate-card">
      <image wx:if="{{candidate.imageUrl && !imageLoadFailed}}" class="candidate-image" src="{{candidate.imageUrl}}" mode="aspectFit" binderror="onImageError"></image>
      <text class="eyebrow">候选新衣 · 标签已确认</text>
      <text class="candidate-name">{{candidate.name}}</text>
      <text class="muted">{{candidate.category}} · {{candidate.color}} · {{candidate.season || '季节未填写'}} · {{candidate.material || '材质未填写'}}</text>
      <text class="muted">{{candidate.price === null || candidate.price === undefined || candidate.price === '' ? '价格未填写' : '¥' + candidate.price}}</text>
    </view>
    <view class="card conclusion"><text class="section-title">{{analysis.conclusion}}</text><text class="status pending">标签规则分析</text><text class="muted">结论依据用户确认的品类、颜色、场景和真实穿着次数，不代表图片同款识别或试穿结果。</text></view>
    <view class="card section"><text class="section-title">重复风险</text><view wx:for="{{analysis.similar}}" wx:key="id" class="outfit-item"><text>{{item.name}} · {{item.color}}</text><text class="muted">标签相似度 {{item.score}} 分 · 已穿 {{item.wear_count || 0}} 次</text><text class="muted">{{item.matchSummary}}</text></view><text wx:if="{{analysis.similar.length === 0}}" class="muted">未发现达到规则阈值的相似旧衣。</text></view>
    <view class="card section"><text class="section-title">分析依据</text><text wx:for="{{analysis.reasons}}" wx:key="*this" class="reason">· {{item}}</text></view>
    <view class="card section"><text class="section-title">可尝试搭配的已有衣物</text><text wx:for="{{analysis.compatible}}" wx:key="id" class="outfit-item">{{item.name}} · {{item.color}}</text><text wx:if="{{analysis.compatible.length === 0}}" class="muted">当前没有足够的确认衣物可供推荐。</text></view>
    <view class="card section"><text class="section-title">试穿前确认</text><text wx:for="{{analysis.needsTryOn}}" wx:key="*this" class="reason">· {{item}}</text></view>
    <view class="decision-row"><button class="ghost" disabled="{{decided}}" bindtap="decide" data-decision="declined">不买</button><button class="secondary" disabled="{{decided}}" bindtap="decide" data-decision="wait">先观望</button><button class="primary" disabled="{{decided}}" bindtap="decide" data-decision="purchased">记录购买</button></view>
    <text wx:if="{{message}}" class="message">{{message}}</text>
    <button wx:if="{{decided}}" class="secondary another" bindtap="startAnother">分析另一件新衣</button>
  </block>
</view>
