<view class="page">
  <view wx:if="{{loading}}" class="empty">正在生成候选报告…</view>
  <view wx:elif="{{error}}" class="empty"><text>{{error}}</text><button class="secondary retry" bindtap="load">重新尝试</button></view>
  <block wx:else>
    <view class="card candidate-card"><text class="eyebrow">候选新衣 · {{candidate.recognitionStatus}}</text><text class="candidate-name">{{candidate.name}}</text><text class="muted">{{candidate.category}} · {{candidate.color}} · ¥{{candidate.price}}</text></view>
    <view class="card conclusion"><text class="section-title">{{analysis.conclusion}}</text><text class="status pending">相似度：{{analysis.similarityStatus}}</text><text class="muted">相似度模型未接入时，报告不会展示分数或假装已完成检索。</text></view>
    <view class="card section"><text class="section-title">分析依据</text><text wx:for="{{analysis.reasons}}" wx:key="*this" class="reason">· {{item}}</text></view>
    <view class="card section"><text class="section-title">可尝试搭配的已有衣物</text><text wx:for="{{analysis.compatible}}" wx:key="id" class="outfit-item">{{item.name}} · {{item.color}}</text><text wx:if="{{analysis.compatible.length === 0}}" class="muted">当前没有足够的确认衣物可供推荐。</text></view>
    <view class="card section"><text class="section-title">试穿前确认</text><text wx:for="{{analysis.needsTryOn}}" wx:key="*this" class="reason">· {{item}}</text></view>
    <view class="decision-row"><button class="secondary" bindtap="decide" data-decision="wait">先观望</button><button class="primary" bindtap="decide" data-decision="purchased">记录购买</button></view>
    <text wx:if="{{message}}" class="message">{{message}}</text>
  </block>
</view>
