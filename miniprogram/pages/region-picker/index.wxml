<view class="page"><text class="intro">选择你当前所在的省、市、区县</text><input class="search" placeholder="搜索区县，例如：朝阳区" value="{{keyword}}" bindinput="onSearch"/><view wx:if="{{results.length}}" class="results"><view wx:for="{{results}}" wx:key="code" class="result" data-code="{{item.code}}" bindtap="chooseResult"><text>{{item.name}}</text><text>{{item.path}}</text></view></view><view class="picker-card"><text>省级地区</text><picker range="{{provinces}}" range-key="name" value="{{provinceIndex}}" bindchange="onProvinceChange"><view class="picker-value">{{provinces[provinceIndex].name}} <text>›</text></view></picker></view><view class="picker-card"><text>城市</text><picker range="{{cities}}" range-key="name" value="{{cityIndex}}" bindchange="onCityChange"><view class="picker-value">{{cities[cityIndex].name}} <text>›</text></view></picker></view><view class="picker-card"><text>区县</text><picker range="{{districts}}" range-key="name" value="{{districtIndex}}" bindchange="onDistrictChange"><view class="picker-value">{{districts[districtIndex].name}} <text>›</text></view></picker></view><button class="primary" bindtap="confirm">确认所在地区</button></view>
