.page{min-height:100vh;padding:38rpx 32rpx;background:#fbf8f3;color:#5f4a3a;box-sizing:border-box}.intro{display:block;margin-bottom:24rpx;color:#856f5f}.search{height:80rpx;padding:0 24rpx;border-radius:22rpx;background:#fffdf9;box-sizing:border-box}.results{max-height:420rpx;margin-top:16rpx;overflow:auto;border-radius:20rpx;background:#fffdf9}.result{display:flex;flex-direction:column;padding:20rpx 24rpx;border-bottom:1rpx solid #f0e8df}.result text:last-child{margin-top:6rpx;color:#9c897a;font-size:23rpx}.picker-card{margin-top:22rpx;padding:24rpx;border-radius:24rpx;background:#fffdf9;box-shadow:0 8rpx 22rpx rgba(119,91,66,.07);font-size:25rpx;color:#957f70}.picker-value{display:flex;justify-content:space-between;margin-top:12rpx;color:#5f4a3a;font-size:34rpx;font-weight:600}.primary{margin-top:44rpx;border-radius:48rpx;background:#b298c2;color:#fff}
