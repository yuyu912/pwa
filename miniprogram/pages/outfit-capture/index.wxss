.page{padding:32rpx;background:#f8f4ff;min-height:100vh}.heading{display:block;font-size:46rpx;font-weight:700;color:#29243d}.desc,.hint{display:block;color:#7f788d;margin:12rpx 0;line-height:1.6}.primary,.ghost{margin:24rpx 0;border-radius:999rpx}.primary{background:#302846;color:#fff}.ghost{background:#fff;color:#5f5675}.preview{width:100%;height:420rpx;border-radius:28rpx;background:#fff}.privacy{display:block;color:#4b8a67;margin:20rpx}.error{display:block;color:#a65454;margin:20rpx 0}.card{background:#fff;border-radius:28rpx;padding:24rpx;margin:24rpx 0}.title{display:block;font-size:30rpx;font-weight:650}.match{display:flex;gap:20rpx;align-items:center;padding:16rpx;border:2rpx solid transparent;border-radius:20rpx}.match.active,.chip.active{border-color:#7966a8;background:#f1ebff}.match image{width:100rpx;height:100rpx}.chips{display:flex;flex-wrap:wrap;gap:12rpx}.chip{padding:12rpx 20rpx;background:#f4f1f7;border:2rpx solid transparent;border-radius:999rpx}.picker{padding:24rpx;background:#fff;border-radius:20rpx}
.detected-image{width:100%;height:260rpx;background:#faf8fc;border-radius:20rpx}.new-default{display:block;margin:12rpx 0;color:#4b8a67;font-weight:600}
.processing,.failed{margin:20rpx 0;padding:22rpx;border-radius:18rpx;background:#f2edf8;color:#755f86}.failed{background:#fff0f0;color:#a65454}.failed text{display:block;margin:6rpx 0}.verified,.fallback{display:block;margin:14rpx 0;line-height:1.5}.verified{color:#4b8a67}.fallback{color:#9b6d45}
