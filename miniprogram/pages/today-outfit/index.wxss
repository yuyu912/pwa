.page{min-height:100vh;padding:56rpx 32rpx;background:#f8f5fb;color:#55425f;box-sizing:border-box}.eyebrow{display:block;color:#a58bb4;font-size:25rpx}.heading{display:block;margin:12rpx 0 28rpx;font-size:52rpx;font-weight:600}.scene-field{display:flex;align-items:center;justify-content:space-between;margin-bottom:26rpx;padding:22rpx 26rpx;border-radius:24rpx;background:#fffdfa}.scene-label{color:#806e86}.scene-picker{min-width:150rpx;text-align:right;color:#8062a3;font-weight:600}.outfit-card{padding:28rpx;border-radius:32rpx;background:#fffdfa;box-shadow:0 14rpx 34rpx rgba(106,79,122,.09)}.outfit-art{min-height:360rpx;display:flex;align-items:stretch;justify-content:center;gap:16rpx;padding:20rpx;border-radius:24rpx;background:linear-gradient(135deg,#fff7ec,#eee5f6);box-sizing:border-box}.outfit-item{flex:1;min-width:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10rpx;text-align:center;color:#8a7196;font-size:28rpx}.outfit-item image{width:150rpx;height:180rpx}.item-meta{color:#9b879f;font-size:22rpx}.title{display:block;margin-top:30rpx;font-size:42rpx;font-weight:600}.desc{display:block;margin-top:14rpx;line-height:1.8;color:#806e86}.missing{display:block;margin-top:16rpx;color:#a16868}.tags{display:flex;flex-wrap:wrap;gap:12rpx;margin-top:24rpx}.tags text{padding:6rpx 16rpx;border-radius:99rpx;background:#f0e8f6;color:#957ba5;font-size:24rpx}.primary,.secondary,.ghost{margin-top:30rpx;border-radius:48rpx}.primary{background:#a88ebb;color:white}.secondary{background:#eee5f6;color:#8062a3}.ghost{background:transparent;color:#8c7496}
