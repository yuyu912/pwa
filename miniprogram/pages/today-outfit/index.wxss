.page{min-height:100vh;padding:38rpx 32rpx 70rpx;background:#f7f0e3;color:#5c4b40;box-sizing:border-box}.weather-strip{display:flex;align-items:center;justify-content:space-between;padding:24rpx 26rpx;border:2rpx solid #d6c8b3;border-radius:28rpx;background:#e7eee4}.strip-place,.strip-meta{display:block}.strip-place{font-size:28rpx;font-weight:600}.strip-meta{margin-top:6rpx;color:#7e786c;font-size:20rpx}.strip-reading{display:flex;flex-direction:column;align-items:flex-end;gap:4rpx;color:#68765f;font-size:29rpx;font-weight:600}.heading{display:block;margin:30rpx 0 22rpx;font-size:48rpx;font-weight:600;letter-spacing:4rpx}.scene-field{display:flex;align-items:center;justify-content:space-between;margin-bottom:24rpx;padding:21rpx 25rpx;border:2rpx solid #dfd1bd;border-radius:23rpx;background:#fffaf1}.scene-label{color:#736359}.scene-picker{min-width:150rpx;color:#738166;font-weight:600;text-align:right}.outfit-card{padding:27rpx;border:2rpx solid #dfd1bd;border-radius:32rpx;background:#fffaf1}.outfit-art{display:grid;grid-template-columns:repeat(2,1fr);gap:18rpx;padding:22rpx;border-radius:26rpx;background:#f1e6d7}.outfit-item{display:flex;min-width:0;flex-direction:column;align-items:center;text-align:center}.item-photo{display:flex;align-items:center;justify-content:center;width:100%;height:220rpx;border-radius:50% 46% 48% 44%;background:#fffaf0}.item-photo image{width:170rpx;height:195rpx}.item-placeholder{position:relative;width:100rpx;height:100rpx;border-bottom:3rpx solid #bcae9e}.hanger-line{position:absolute;left:34rpx;top:20rpx;width:38rpx;height:38rpx;border-top:3rpx solid #bcae9e;border-left:3rpx solid #bcae9e;transform:rotate(45deg)}.item-name{margin-top:12rpx;font-size:27rpx;font-weight:600}.item-meta{margin-top:5rpx;color:#958273;font-size:20rpx}.title{display:block;margin-top:27rpx;font-size:36rpx;font-weight:600}.desc{display:block;margin-top:13rpx;color:#796a5f;line-height:1.75}.missing{display:flex;flex-direction:column;gap:8rpx;margin-top:18rpx;padding:18rpx 20rpx;border-radius:20rpx;background:#f7e6dc;color:#9a6558}.tags{display:flex;flex-wrap:wrap;gap:11rpx;margin-top:22rpx}.tags text{padding:7rpx 15rpx;border-radius:99rpx;background:#e5ecdf;color:#69775e;font-size:22rpx}.primary,.secondary,.ghost{margin-top:27rpx;border-radius:46rpx}.primary{background:#a4ad8e;color:#fff}.secondary{background:#e6ecdf;color:#68765e}.primary::after,.secondary::after,.ghost::after{border:0}.reroll-note{display:block;margin-top:24rpx;color:#9a8a7e;font-size:23rpx;text-align:center}.ghost{background:transparent;color:#89776a}.gap-card{background:#f9e9df;border-color:#ead0c0}.empty{display:flex;min-height:65vh;flex-direction:column;align-items:center;justify-content:center;text-align:center}.empty .desc{max-width:560rpx}.empty .primary{width:100%}
