.page{min-height:100vh;padding:56rpx 32rpx;background:#f8f5fb;color:#55425f;box-sizing:border-box}.eyebrow{display:block;color:#a58bb4;font-size:25rpx}.heading{display:block;margin:12rpx 0 42rpx;font-size:52rpx;font-weight:600}.outfit-card{padding:28rpx;border-radius:32rpx;background:#fffdfa;box-shadow:0 14rpx 34rpx rgba(106,79,122,.09)}.outfit-art{height:360rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:20rpx;border-radius:24rpx;background:linear-gradient(135deg,#fff7ec,#eee5f6);color:#8a7196;font-size:34rpx}.title{display:block;margin-top:30rpx;font-size:42rpx;font-weight:600}.desc{display:block;margin-top:14rpx;line-height:1.8;color:#806e86}.tags{display:flex;gap:12rpx;margin-top:24rpx}.tags text{padding:6rpx 16rpx;border-radius:99rpx;background:#f0e8f6;color:#957ba5;font-size:24rpx}.primary,.ghost{margin-top:30rpx;border-radius:48rpx}.primary{background:#a88ebb;color:white}.ghost{background:transparent;color:#8c7496}
