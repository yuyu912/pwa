<view class="page"><view wx:if="{{!location}}" class="empty"><text class="heading">先告诉我你在哪里</text><text class="desc">选择所在地区后，才会按当地实时天气从衣橱里搭配。</text><button class="primary" bindtap="chooseRegion">选择地区</button></view><view wx:elif="{{error}}" class="outfit-card"><text class="title">实时天气暂不可用</text><text class="desc">{{error}}</text></view><view wx:elif="{{!weather}}" class="outfit-card"><text class="title">正在获取实时天气</text></view><block wx:else><text class="eyebrow">{{location.fullName}} · {{weather.condition}} · {{weather.temperature}}°C · {{weather.reportTime}}</text><text class="heading">智能搭配生成</text><view class="scene-field"><text class="scene-label">今天准备去哪里？</text><picker mode="selector" range="{{scenes}}" value="{{sceneIndex}}" bindchange="onSceneChange"><view class="scene-picker">{{scene}} ›</view></picker></view><view wx:if="{{recommendation.items.length}}" class="outfit-card"><view class="outfit-art"><view wx:for="{{recommendation.items}}" wx:key="id" class="outfit-item"><image wx:if="{{item.imageUrl}}" src="{{item.imageUrl}}" mode="aspectFit"/><text>{{item.name}}</text><text class="item-meta">{{item.category}}{{item.color ? ' · ' + item.color : ''}}</text></view></view><text class="title">{{recommendation.complete ? scene + '搭配建议' : scene + '单品建议'}}</text><text class="desc">{{recommendation.reason}}</text><text class="desc">{{weather.tip}}</text><text wx:if="{{recommendation.missing.length}}" class="missing">还缺少：{{recommendation.missing.join('、')}}</text><view class="tags"><text>本人真实衣物</text><text>场景优先</text><text>实时温度筛选</text></view><button class="secondary" bindtap="changeOutfit">换一套</button></view><view wx:else class="outfit-card"><text class="title">衣橱暂时缺少适合今天的完整搭配</text><text class="desc">建议补充：{{recommendation.missing.join('、')}}</text></view><button class="capsule-entry" bindtap="toCapsulePlan">规划 {{scene}} 7 天胶囊</button><button class="primary" bindtap="toWardrobe">去衣橱看看</button></block><button class="ghost" bindtap="goBack">回到首页</button></view>
