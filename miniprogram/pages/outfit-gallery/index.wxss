.gallery-page{min-height:100vh;padding:34rpx 28rpx 70rpx;background:#f7f0e3;color:#5c4b40;box-sizing:border-box}.gallery-head{display:flex;align-items:center;justify-content:space-between}.eyebrow,.headline{display:block}.eyebrow{color:#879276;font-size:20rpx;letter-spacing:4rpx}.headline{margin-top:8rpx;font-size:42rpx;font-weight:700}.create-button{margin:0;padding:0 28rpx;height:64rpx;border-radius:99rpx;background:#e9eedf;color:#65725c;font-size:23rpx;line-height:64rpx}.create-button::after,.state-card button::after{border:0}.intro{display:block;margin:18rpx 0 26rpx;color:#88796e;font-size:23rpx;line-height:1.65}.state-card{display:flex;min-height:300rpx;align-items:center;justify-content:center;flex-direction:column;padding:38rpx;border:2rpx solid #ded0bb;border-radius:28rpx;background:#fffaf0;color:#8d7c70;text-align:center;box-sizing:border-box}.state-card button{margin-top:24rpx;background:#9ca987;color:#fff}.error-state{color:#a66b62}.empty-title{font-size:30rpx;font-weight:700}.empty-copy{margin-top:14rpx;font-size:22rpx;line-height:1.7}.outfit-grid{display:flex;flex-wrap:wrap;justify-content:space-between;gap:18rpx 0}.outfit-card{width:48.7%;overflow:hidden;border:2rpx solid #e2d6c4;border-radius:26rpx;background:#fffaf1;box-shadow:0 10rpx 24rpx rgba(94,72,54,.08)}.preview-canvas{position:relative;height:420rpx;overflow:hidden;background-color:#fffdf8;background-image:linear-gradient(rgba(189,179,163,.08) 1rpx,transparent 1rpx),linear-gradient(90deg,rgba(189,179,163,.08) 1rpx,transparent 1rpx);background-size:36rpx 36rpx}.preview-layer{position:absolute;display:flex;align-items:center;justify-content:center;transform-origin:center}.preview-layer image{width:100%;height:100%}.image-placeholder{display:flex;width:100%;height:100%;align-items:center;justify-content:center;border-radius:18rpx;background:#eee6d8;color:#927e6f;font-size:18rpx}.card-copy{padding:18rpx}.plan-title,.plan-meta{display:block}.plan-title{overflow:hidden;color:#5f5046;font-size:25rpx;font-weight:700;text-overflow:ellipsis;white-space:nowrap}.plan-meta{margin-top:8rpx;color:#9a8a7e;font-size:19rpx}
