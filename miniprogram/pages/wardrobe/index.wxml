<view class="page wardrobe-page">
  <view class="topline">
    <view>
      <text class="eyebrow">{{user.username}} 的衣橱</text>
      <text class="headline">先看看你已经拥有的。</text>
    </view>
    <text class="status mock">模拟模式</text>
  </view>

  <view class="search-card card">
    <input value="{{keyword}}" bindinput="onKeyword" placeholder="搜索名称、颜色、材质或场景" />
    <scroll-view class="categories" scroll-x>
      <text wx:for="{{categories}}" wx:key="*this" class="category {{activeCategory === item ? 'active' : ''}}" bindtap="selectCategory" data-category="{{item}}">{{item}}</text>
    </scroll-view>
    <text class="filter-label">季节</text>
    <scroll-view class="filter-options" scroll-x><text wx:for="{{seasons}}" wx:key="*this" class="filter-chip {{activeSeason === item ? 'active' : ''}}" bindtap="selectSeason" data-value="{{item}}">{{item}}</text></scroll-view>
    <text class="filter-label">厚薄</text>
    <scroll-view class="filter-options" scroll-x><text wx:for="{{thicknesses}}" wx:key="*this" class="filter-chip {{activeThickness === item ? 'active' : ''}}" bindtap="selectThickness" data-value="{{item}}">{{item}}</text></scroll-view>
    <text class="filter-label">本月穿着状态</text>
    <scroll-view class="filter-options" scroll-x><text wx:for="{{wearStatuses}}" wx:key="*this" class="filter-chip {{activeWearStatus === item ? 'active' : ''}}" bindtap="selectWearStatus" data-value="{{item}}">{{item}}</text></scroll-view>
    <text class="filter-label">私人闲置状态</text>
    <scroll-view class="filter-options" scroll-x><text wx:for="{{idleStatuses}}" wx:key="*this" class="filter-chip {{activeIdleStatus === item ? 'active' : ''}}" bindtap="selectIdleStatus" data-value="{{item}}">{{item}}</text></scroll-view>
  </view>

  <view class="idle-entry card" bindtap="openIdleItems"><view><text class="idle-entry-title">私人闲置清单</text><text class="idle-entry-note">仅你可见，不会公开、交换或出租</text></view><text class="idle-entry-arrow">›</text></view>
  <view class="canvas-entry card" bindtap="openOutfitGallery"><view><text class="canvas-entry-title">我的搭配</text><text class="canvas-entry-note">查看所有保存过的搭配方案</text></view><text class="canvas-entry-arrow">›</text></view>
  <view class="canvas-entry card" bindtap="openOutfitCanvas"><view><text class="canvas-entry-title">自主搭配画布</text><text class="canvas-entry-note">选择真实衣物，自由拖动、缩放和叠放</text></view><text class="canvas-entry-arrow">›</text></view>

  <view wx:if="{{!loading && !error}}" class="filter-summary"><view><text class="summary-number">{{matchedCount}}</text><text class="summary-label">件符合条件</text></view><view><text class="summary-number">{{monthlyWearTotal}}</text><text class="summary-label">次本月穿着</text></view></view>

  <view wx:if="{{loading}}" class="empty">正在读取衣橱…</view>
  <view wx:elif="{{error}}" class="empty"><text>{{error}}</text><button class="secondary retry" bindtap="loadItems">重新尝试</button></view>
  <view wx:elif="{{filteredItems.length === 0}}" class="empty">没有找到符合条件的衣物。</view>
  <view wx:else class="item-list">
    <view wx:for="{{filteredItems}}" wx:key="id" class="item-card card" bindtap="openItem" data-id="{{item.id}}">
      <view class="item-visual" style="background: {{item.color === '深蓝' ? '#324d79' : item.color === '淡紫' ? '#c5b0db' : '#eadfc9'}}">
        <image wx:if="{{item.imageUrl && !item.imageLoadFailed}}" class="item-image" src="{{item.imageUrl}}" mode="aspectFit" binderror="onImageError" data-id="{{item.id}}"></image>
      </view>
      <view class="item-content">
        <text class="item-name">{{item.name}}</text>
        <text wx:if="{{item.idleStatus === 'considering'}}" class="idle-badge">考虑闲置</text>
        <text class="item-meta">{{item.category}} · {{item.color}} · 本月 {{item.monthlyWearCount}} 次 · 累计 {{item.wearCount}} 次</text>
        <text class="item-attributes">{{item.season || '未填写季节'}} · {{item.thickness || '未填写厚薄'}} · {{item.material || '未填写材质'}}</text>
        <view class="tags">
          <text wx:for="{{item.styles}}" wx:for-item="style" wx:key="*this" class="tag style-tag">{{style}}</text>
          <text wx:for="{{item.scenes}}" wx:for-item="scene" wx:key="*this" class="tag">{{scene}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="action-row"><button class="secondary" bindtap="openCandidate">演示候选新衣分析</button></view>
</view>
