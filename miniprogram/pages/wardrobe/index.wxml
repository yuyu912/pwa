<view class="page wardrobe-page">
  <view class="wardrobe-hero">
    <text class="eyebrow">MY WARDROBE</text>
    <text class="headline">{{user.username}} 的衣橱</text>
    <text class="hero-copy">先看看你已经拥有的。</text>
    <view class="hero-thread"></view>
  </view>

  <view class="search-card card">
    <view class="search-field">
      <view class="search-mark"></view>
      <input value="{{keyword}}" bindinput="onKeyword" placeholder="搜索名称、颜色、材质或场景" />
    </view>
    <scroll-view class="categories" scroll-x enhanced show-scrollbar="{{false}}">
      <text wx:for="{{categories}}" wx:key="*this" class="category {{activeCategory === item ? 'active' : ''}}" bindtap="selectCategory" data-category="{{item}}">{{item}}</text>
    </scroll-view>

    <view class="advanced-toggle" bindtap="toggleFilters">
      <view class="advanced-title-row">
        <text class="advanced-title">更多筛选</text>
        <text wx:if="{{advancedFilterCount}}" class="filter-count">· {{advancedFilterCount}} 项</text>
      </view>
      <text class="toggle-copy">{{filtersOpen ? '收起' : '展开'}}</text>
    </view>

    <view wx:if="{{filtersOpen}}" class="advanced-filters">
      <text class="filter-label">季节</text>
      <scroll-view class="filter-options" scroll-x enhanced show-scrollbar="{{false}}"><text wx:for="{{seasons}}" wx:key="*this" class="filter-chip {{activeSeason === item ? 'active' : ''}}" bindtap="selectSeason" data-value="{{item}}">{{item}}</text></scroll-view>
      <text class="filter-label">厚薄</text>
      <scroll-view class="filter-options" scroll-x enhanced show-scrollbar="{{false}}"><text wx:for="{{thicknesses}}" wx:key="*this" class="filter-chip {{activeThickness === item ? 'active' : ''}}" bindtap="selectThickness" data-value="{{item}}">{{item}}</text></scroll-view>
      <text class="filter-label">本月穿着状态</text>
      <scroll-view class="filter-options" scroll-x enhanced show-scrollbar="{{false}}"><text wx:for="{{wearStatuses}}" wx:key="*this" class="filter-chip {{activeWearStatus === item ? 'active' : ''}}" bindtap="selectWearStatus" data-value="{{item}}">{{item}}</text></scroll-view>
      <text class="filter-label">私人闲置状态</text>
      <scroll-view class="filter-options" scroll-x enhanced show-scrollbar="{{false}}"><text wx:for="{{idleStatuses}}" wx:key="*this" class="filter-chip {{activeIdleStatus === item ? 'active' : ''}}" bindtap="selectIdleStatus" data-value="{{item}}">{{item}}</text></scroll-view>
    </view>
  </view>

  <view wx:if="{{!loading && !error}}" class="filter-summary">
    <view class="summary-note summary-note-primary"><text class="summary-number">{{matchedCount}}</text><text class="summary-label">件符合条件</text></view>
    <view class="summary-note summary-note-secondary"><text class="summary-number">{{monthlyWearTotal}}</text><text class="summary-label">次本月穿着</text></view>
  </view>

  <view class="shortcut-grid">
    <view class="shortcut-card saved-shortcut" bindtap="openOutfitGallery">
      <image class="paper-shape" src="/assets/home-paper-record.png" mode="scaleToFill" />
      <view class="shortcut-copy"><text class="shortcut-kicker">SAVED</text><text class="shortcut-title">我的搭配</text><text class="shortcut-note">查看保存过的搭配方案</text></view>
    </view>
    <view class="shortcut-card canvas-shortcut" bindtap="openOutfitCanvas">
      <image class="paper-shape" src="/assets/home-paper-wardrobe.png" mode="scaleToFill" />
      <view class="shortcut-copy"><text class="shortcut-kicker">CANVAS</text><text class="shortcut-title">自主搭配画布</text><text class="shortcut-note">用真实衣物自由组合</text></view>
    </view>
  </view>

  <view class="idle-entry" bindtap="openIdleItems">
    <image class="paper-shape" src="/assets/home-paper-link.png" mode="scaleToFill" />
    <view class="idle-copy"><text class="idle-entry-title">私人闲置清单</text><text class="idle-entry-note">仅你可见，不会公开、交换或出租</text></view>
  </view>

  <view class="candidate-entry" bindtap="openCandidate">
    <view class="candidate-copy"><text class="candidate-kicker">BEFORE BUYING</text><text class="candidate-title">购买前拍照查重</text><text class="candidate-note">拍下准备购买的衣服，看看衣橱里有没有相似款</text></view>
    <text class="candidate-action">去查一查</text>
  </view>

  <view wx:if="{{loading}}" class="empty">正在读取衣橱…</view>
  <view wx:elif="{{error}}" class="empty"><text>{{error}}</text><button class="secondary retry" bindtap="loadItems">重新尝试</button></view>
  <view wx:elif="{{filteredItems.length === 0}}" class="empty">没有找到符合条件的衣物。</view>
  <view wx:else class="item-list">
    <view wx:for="{{filteredItems}}" wx:key="id" class="item-card card" bindtap="openItem" data-id="{{item.id}}">
      <view class="item-visual" style="background: {{item.color === '深蓝' ? '#324d79' : item.color === '淡紫' ? '#c5b0db' : '#eadfc9'}}">
        <image wx:if="{{item.imageUrl && !item.imageLoadFailed}}" class="item-image" src="{{item.imageUrl}}" mode="aspectFit" binderror="onImageError" data-id="{{item.id}}"></image>
      </view>
      <view class="item-content">
        <view class="item-title-row"><text class="item-name">{{item.name}}</text><text wx:if="{{item.idleStatus === 'considering'}}" class="idle-badge">考虑闲置</text></view>
        <text class="item-meta">{{item.category}} · {{item.color}} · 本月 {{item.monthlyWearCount}} 次 · 累计 {{item.wearCount}} 次</text>
        <text class="item-attributes">{{item.season || '未填写季节'}} · {{item.thickness || '未填写厚薄'}} · {{item.material || '未填写材质'}}</text>
        <view class="tags">
          <text wx:for="{{item.styles}}" wx:for-item="style" wx:key="*this" class="tag style-tag">{{style}}</text>
          <text wx:for="{{item.scenes}}" wx:for-item="scene" wx:key="*this" class="tag">{{scene}}</text>
        </view>
      </view>
    </view>
  </view>

</view>
