.calendar-page { padding-top: 20rpx; padding-bottom: calc(150rpx + env(safe-area-inset-bottom)); }

.date-hero { display: grid; min-height: 154rpx; padding: 8rpx 4rpx 24rpx; align-items: center; grid-template-columns: 76rpx minmax(0, 1fr) 76rpx; column-gap: 24rpx; box-sizing: border-box; }
.month-button { display: flex; width: 76rpx; height: 68rpx; border: 2rpx solid rgba(193, 126, 140, .18); border-radius: 27rpx 20rpx 29rpx 22rpx / 21rpx 28rpx 20rpx 27rpx; align-items: center; justify-content: center; box-sizing: border-box; background: rgba(244, 228, 228, .7); color: #8b5f69; font-size: 40rpx; line-height: 1; transition: transform .16s ease, background-color .16s ease; }
.month-button-pressed { background: #ecd8db !important; transform: scale(.96); }
.date-copy { display: flex; min-width: 0; align-items: center; flex-direction: column; text-align: center; }
.date-kicker { color: #ad7782; font-size: 18rpx; letter-spacing: 2rpx; white-space: nowrap; }
.date-title { margin-top: 4rpx; color: #443a38; font-size: 51rpx; font-weight: 700; line-height: 1.1; white-space: nowrap; }
.date-subtitle { margin-top: 8rpx; color: #877d79; font-size: 22rpx; letter-spacing: 1rpx; white-space: nowrap; }
.state-card { margin-top: 24rpx; text-align: center; }
.error-text { display: block; color: #a05f67; font-size: 25rpx; }
.retry-button { margin-top: 20rpx; font-size: 25rpx; }

.history-summary-card { display: flex; min-height: 184rpx; margin-top: 24rpx; padding: 25rpx 22rpx; align-items: center; gap: 18rpx; box-sizing: border-box; }
.history-summary-copy { display: flex; width: 198rpx; flex: 0 0 198rpx; flex-direction: column; }
.history-kicker { color: #ad7782; font-size: 18rpx; font-weight: 600; letter-spacing: 2rpx; }
.history-number { color: #8d5662; font-size: 44rpx; font-weight: 700; }
.history-unit,
.history-meta { color: #8f7d78; font-size: 20rpx; }
.history-meta { display: block; margin-top: 5rpx; }
.history-item-scroll { min-width: 0; flex: 1; white-space: nowrap; }
.history-item-row { display: inline-flex; align-items: flex-end; gap: 5rpx; padding-right: 8rpx; }
.history-item { width: 91rpx; height: 116rpx; flex: 0 0 91rpx; transition: transform .16s ease, opacity .16s ease; }
.history-item-pressed { opacity: .82; transform: translateY(-4rpx) scale(.96); }
.history-item-image,
.history-item-placeholder { width: 100%; height: 100%; }
.history-item-placeholder { display: flex; align-items: center; justify-content: center; color: #9b6b78; font-size: 25rpx; }
.history-empty { min-width: 0; flex: 1; color: #998d88; font-size: 22rpx; text-align: center; }
.favorite-card { display: flex; min-height: 190rpx; margin-top: 22rpx; padding: 26rpx 29rpx; align-items: center; justify-content: space-between; transition: transform .18s ease, opacity .18s ease; box-sizing: border-box; }
.favorite-card-pressed { opacity: .88; transform: scale(.98); }
.favorite-copy { display: flex; min-width: 0; flex: 1; flex-direction: column; }
.favorite-name { display: block; max-width: 410rpx; margin-top: 12rpx; overflow: hidden; color: #51413f; font-size: 34rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.favorite-image,
.favorite-placeholder { width: 170rpx; height: 142rpx; flex: 0 0 170rpx; }
.favorite-placeholder { display: flex; align-items: center; justify-content: center; color: #9b6b78; font-size: 34rpx; }
.favorite-empty { min-height: 156rpx; }

.calendar-card { position: relative; margin-top: 24rpx; padding: 30rpx 14rpx 22rpx; }
.calendar-tape { position: absolute; top: -9rpx; left: 50%; width: 112rpx; height: 28rpx; border-radius: 4rpx; background: rgba(226, 210, 232, .58); transform: translateX(-50%) rotate(-1deg); }
.weekday-row, .days-grid { display: grid; grid-template-columns: repeat(7, 1fr); }
.weekday { padding: 10rpx 0 16rpx; color: #91859a; font-size: 22rpx; text-align: center; }
.calendar-day { position: relative; display: flex; height: 116rpx; margin: 3rpx; overflow: hidden; border-radius: 21rpx 17rpx 23rpx 18rpx / 18rpx 23rpx 17rpx 21rpx; align-items: center; justify-content: center; background: #f2efe9; color: #5b515d; transition: transform .16s ease, background-color .2s ease; box-sizing: border-box; }
.calendar-day.selected { border-radius: 23rpx 17rpx 25rpx 18rpx / 17rpx 25rpx 18rpx 23rpx; background: #bd7381; color: #fff; animation: day-select-pop .28s ease-out; }
.day-pressed { transform: scale(.94) !important; }
.empty-day { opacity: .62; pointer-events: none; }
.trailing-empty { opacity: 0; }
.day-number { z-index: 3; width: 100%; font-size: 27rpx; line-height: 1; text-align: center; }
.day-preview { position: absolute; top: 6rpx; right: 5rpx; bottom: 6rpx; left: 5rpx; z-index: 1; display: grid; align-items: center; justify-items: center; gap: 0; }
.preview-one { grid-template-columns: 1fr; }
.preview-two { grid-template-columns: repeat(2, 1fr); }
.preview-four { grid-template-columns: repeat(2, 1fr); }
.preview-many { grid-template-columns: repeat(3, 1fr); }
.day-garment-wrap { width: 100%; height: 100%; min-width: 0; min-height: 0; animation: garment-arrive .34s ease-out both; }
.preview-one .day-garment-wrap { width: 64rpx; height: 78rpx; }
.day-garment,
.day-garment-placeholder { width: 100%; height: 100%; }
.day-garment-placeholder { display: flex; align-items: center; justify-content: center; color: rgba(139, 93, 104, .72); font-size: 18rpx; }
.record-dot { position: absolute; right: 4rpx; bottom: 4rpx; z-index: 4; min-width: 25rpx; height: 25rpx; padding: 0 4rpx; border-radius: 999rpx; background: #f1dfe2; color: #8c5963; font-size: 16rpx; line-height: 25rpx; text-align: center; box-sizing: border-box; }
.selected .record-dot { background: #fffaf2; }

.day-section { margin-top: 31rpx; }
.section-kicker { display: block; color: #a76f7b; font-size: 18rpx; letter-spacing: 3rpx; }
.section-title { display: block; margin: 5rpx 0 16rpx; color: #554b47; font-size: 30rpx; font-weight: 700; }
.empty-day-copy { text-align: center; }
.outfit-card { margin-bottom: 17rpx; padding: 23rpx 21rpx 25rpx; transition: transform .18s ease, opacity .18s ease; }
.outfit-card-pressed { opacity: .9; transform: scale(.985); }
.outfit-card:nth-child(odd) { border-radius: 26rpx 43rpx 30rpx 45rpx / 40rpx 28rpx 42rpx 30rpx; }
.outfit-card-openable { border-color: rgba(189,115,129,.28); }
.outfit-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 14rpx; }
.outfit-heading { min-width: 0; flex: 1; }
.outfit-status { flex: 0 0 auto; }
.outfit-title { display: block; overflow: hidden; color: #504744; font-size: 29rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.outfit-count { display: block; padding: 7rpx 14rpx; border-radius: 999rpx; background: #f1dfe2; color: #815963; font-size: 20rpx; }
.outfit-open-note { display: block; margin-top: 7rpx; color: #9b6671; font-size: 18rpx; text-align: center; }
.outfit-note { display: block; margin-top: 12rpx; color: #776d79; font-size: 22rpx; }
.outfit-items { display: flex; gap: 14rpx; margin-top: 18rpx; padding-top: 17rpx; border-top: 2rpx dashed rgba(166, 146, 179, .2); overflow-x: auto; }
.outfit-item { width: 142rpx; flex: 0 0 142rpx; }
.item-image, .item-placeholder { width: 136rpx; height: 136rpx; border: 2rpx solid rgba(189,115,129,.13); border-radius: 29rpx 20rpx 32rpx 23rpx / 22rpx 31rpx 20rpx 29rpx; box-sizing: border-box; }
.item-image { background: #fffdf8; }
.item-placeholder { background: #f1dfe2; color: #a76f7b; font-size: 37rpx; line-height: 132rpx; text-align: center; }
.item-name, .item-meta, .inactive-label { display: block; margin-top: 6rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.item-name { color: #51484b; font-size: 21rpx; font-weight: 700; }
.item-meta { color: #8b8186; font-size: 19rpx; }
.inactive-label { color: #a36b73; font-size: 19rpx; }

@keyframes day-select-pop {
  0% { transform: scale(.92) rotate(-1deg); }
  70% { transform: scale(1.035) rotate(-1deg); }
  100% { transform: scale(1) rotate(-1deg); }
}

@keyframes garment-arrive {
  from { opacity: 0; transform: translateY(7rpx) scale(.92); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}

/* 首页莓果粉主题：保留日历结构，只替换旧紫色。 */
.calendar-page { background: #f8f3e8; color: #554b47; }
.hero-thread { border-color: rgba(193, 126, 140, .45); }
.month-button { border-color: rgba(193, 126, 140, .2); background: #f4e4e4; color: #8b5f69; }
.shortcut-kicker,
.section-kicker { color: #ad7782; }
.calendar-page .card { border-color: rgba(193, 126, 140, .18); background: #fffaf2; }
.calendar-tape { background: rgba(228, 184, 190, .58); }
.weekday { color: #947f82; }
.calendar-day { color: #5d5050; }
.calendar-page .calendar-day.selected { background: #bd7381; color: #fff; }
.record-dot { background: #f3dfe2; color: #8b5d68; }
.selected .record-dot { background: #fffaf2; }
.outfit-card-openable { border-color: rgba(193, 126, 140, .3); }
.outfit-count,
.item-placeholder { background: #f3e2e4; color: #8c6270; }
.outfit-open-note { color: #9b6b78; }
.outfit-items { border-color: rgba(193, 126, 140, .2); }
.item-image,
.item-placeholder { border-color: rgba(193, 126, 140, .15); }
