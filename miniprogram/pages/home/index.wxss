.home-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 0 32rpx 190rpx;
  background: #f8f4eb;
  color: #544b47;
}

.top-space {
  display: flex;
  align-items: flex-end;
  justify-content: center;
  height: 158rpx;
  padding-bottom: 22rpx;
  box-sizing: border-box;
}

.brand {
  color: #4f4744;
  font-family: "Avenir Next", "Trebuchet MS", sans-serif;
  font-size: 54rpx;
  font-weight: 400;
  letter-spacing: 1rpx;
}

.hero-section {
  position: relative;
  height: 508rpx;
  overflow: hidden;
  border-radius: 48rpx 38rpx 52rpx 42rpx;
  background: #f8f4eb;
}

.hero-image {
  width: 100%;
  height: 100%;
}

.weather-card {
  position: absolute;
  top: 338rpx;
  left: 4rpx;
  display: flex;
  align-items: center;
  width: 238rpx;
  min-height: 92rpx;
  padding: 11rpx 9rpx 11rpx 8rpx;
  border-radius: 48rpx 30rpx 42rpx 34rpx / 34rpx 46rpx 31rpx 43rpx;
  background: rgba(226, 216, 244, 0.94);
  box-sizing: border-box;
  box-shadow: 0 9rpx 22rpx rgba(120, 101, 151, 0.08);
}

.weather-icon-image {
  flex: 0 0 52rpx;
  width: 52rpx;
  height: 43rpx;
}

.weather-content {
  min-width: 0;
  flex: 1;
}

.weather-primary {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
  min-width: 0;
}

.weather-temp,
.weather-copy,
.weather-tip {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.weather-temp {
  flex: 0 0 auto;
  font-size: 23rpx;
  font-weight: 600;
}

.weather-copy {
  min-width: 0;
  color: #5f5552;
  font-size: 19rpx;
  font-weight: 500;
}

.weather-tip {
  display: block;
  margin-top: 4rpx;
  color: #726965;
  font-size: 15rpx;
}

.card-arrow {
  margin-left: 1rpx;
  color: #766a81;
  font-size: 23rpx;
}

.inspiration-card {
  position: relative;
  min-height: 300rpx;
  margin-top: 24rpx;
  background: transparent;
}

.paper-shape {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 0;
  width: 100%;
  height: 100%;
}

.inspiration-content {
  position: relative;
  z-index: 1;
  padding: 35rpx 37rpx 39rpx;
}

.section-title {
  display: block;
  margin-bottom: 20rpx;
  color: #4f4744;
  font-size: 31rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.link-field {
  padding: 12rpx;
  border: 2rpx solid rgba(161, 143, 188, 0.16);
  border-radius: 32rpx 22rpx 31rpx 25rpx / 24rpx 31rpx 22rpx 30rpx;
  background: rgba(255, 252, 246, 0.82);
  transform: rotate(0.3deg);
}

.link-field input {
  height: 78rpx;
  padding: 0 22rpx;
  color: #625b58;
  font-size: 25rpx;
}

.link-field button {
  width: 100%;
  height: 82rpx;
  padding: 0 16rpx;
  border-radius: 31rpx 21rpx 29rpx 24rpx / 22rpx 30rpx 21rpx 28rpx;
  background: #9c89c3;
  color: #fff;
  font-size: 25rpx;
  line-height: 82rpx;
  white-space: nowrap;
  box-sizing: border-box;
}

.link-field button::after,
.add-row button::after {
  border: 0;
}

.entry-grid {
  display: grid;
  grid-template-columns: 0.94fr 1.06fr;
  align-items: start;
  gap: 20rpx;
  margin-top: 24rpx;
}

.entry-card {
  position: relative;
  height: 322rpx;
  padding: 21rpx 17rpx 17rpx;
  overflow: visible;
  background: transparent;
  box-sizing: border-box;
  transform: rotate(-0.8deg) translateY(18rpx);
}

.entry-card.record-entry {
  height: 342rpx;
  padding: 17rpx 18rpx 18rpx;
  transform: rotate(0.65deg) translateY(1rpx);
}

.entry-art {
  position: relative;
  z-index: 1;
  width: 100%;
  height: 184rpx;
  overflow: hidden;
  border-radius: 42rpx 19rpx 35rpx 23rpx / 23rpx 37rpx 21rpx 39rpx;
  transform: rotate(-0.45deg);
}

.entry-art image {
  width: 100%;
  height: 100%;
  opacity: 0.92;
}

.record-entry .entry-art {
  height: 207rpx;
  border-radius: 21rpx 44rpx 25rpx 39rpx / 38rpx 24rpx 43rpx 23rpx;
  transform: rotate(0.4deg);
}

.entry-copy {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  gap: 3rpx;
  padding: 10rpx 8rpx 7rpx;
  background: transparent;
}

.record-entry .entry-copy {
  background: transparent;
}

.entry-title {
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.25;
}

.entry-subtitle {
  display: block;
  width: 100%;
  overflow: hidden;
  color: #817774;
  font-size: 18rpx;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.add-row {
  display: flex;
  margin-top: 22rpx;
}

.add-row button {
  flex: 1;
  height: 76rpx;
  border: 3rpx solid #aa98ca;
  border-radius: 999rpx;
  background: rgba(255, 252, 246, 0.72);
  color: #9581bd;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 70rpx;
}

.bottom-nav {
  position: fixed;
  right: 30rpx;
  bottom: 24rpx;
  left: 30rpx;
  z-index: 8;
  display: flex;
  justify-content: space-around;
  padding: 17rpx 8rpx 13rpx;
  border: 2rpx solid rgba(222, 214, 201, 0.72);
  border-radius: 52rpx 48rpx 54rpx 46rpx;
  background: rgba(255, 252, 246, 0.97);
  box-shadow: 0 9rpx 25rpx rgba(94, 72, 54, 0.1);
}

.nav-item {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  gap: 7rpx;
  color: #625a57;
  font-size: 22rpx;
}

.nav-item.active {
  color: #8e79b5;
  font-weight: 600;
}

.home-icon,
.bulb-icon,
.closet-icon {
  position: relative;
  width: 50rpx;
  height: 43rpx;
}

.home-roof {
  position: absolute;
  top: 3rpx;
  left: 10rpx;
  width: 28rpx;
  height: 28rpx;
  border-top: 4rpx solid currentColor;
  border-left: 4rpx solid currentColor;
  transform: rotate(45deg);
}

.home-body {
  position: absolute;
  bottom: 2rpx;
  left: 12rpx;
  width: 26rpx;
  height: 23rpx;
  border-right: 4rpx solid currentColor;
  border-bottom: 4rpx solid currentColor;
  border-left: 4rpx solid currentColor;
}

.bulb-core {
  position: absolute;
  top: 7rpx;
  left: 13rpx;
  width: 24rpx;
  height: 24rpx;
  border: 3rpx solid currentColor;
  border-radius: 50%;
}

.bulb-base {
  position: absolute;
  bottom: 0;
  left: 20rpx;
  width: 12rpx;
  height: 8rpx;
  border-top: 3rpx solid currentColor;
  border-bottom: 3rpx solid currentColor;
}

.bulb-ray {
  position: absolute;
  width: 3rpx;
  height: 8rpx;
  background: currentColor;
}

.bulb-top { top: -2rpx; left: 24rpx; }
.bulb-left { top: 7rpx; left: 4rpx; transform: rotate(-50deg); }
.bulb-right { top: 7rpx; right: 4rpx; transform: rotate(50deg); }

.closet-icon {
  display: flex;
  overflow: hidden;
  border: 3rpx solid currentColor;
  border-radius: 4rpx;
}

.closet-icon view {
  flex: 1;
  border-right: 2rpx solid currentColor;
}

.closet-icon view:last-child {
  border: 0;
}
