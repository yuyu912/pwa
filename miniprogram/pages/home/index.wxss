solute;top:7rpx;left:13rpx;width:24rpx;height:24rpx;border:3rpx solid currentColor;border-radius:50%}.bulb-base{position:absolute;left:20rpx;bottom:0;width:12rpx;height:8rpx;border-top:3rpx solid currentColor;border-bottom:3rpx solid currentColor}.bulb-ray{position:absolute;width:3rpx;height:8rpx;background:currentColor}.bulb-top{top:-2rpx;left:24rpx}.bulb-left{top:7rpx;left:4rpx;transform:rotate(-50deg)}.bulb-right{top:7rpx;right:4rpx;transform:rotate(50deg)}.closet-icon{display:flex;overflow:hidden;border:3rpx solid currentColor;border-radius:4rpx}.closet-icon view{flex:1;border-right:2rpx solid currentColor}.closet-icon view:last-child{border:0}
