.home-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 0 32rpx calc(150rpx + env(safe-area-inset-bottom));
  background: #fbf6f0;
  color: #544b47;
  font-family: "Kaiti SC", "STKaiti", "KaiTi", "FangSong", serif;
}

.top-space {
  display: flex;
  align-items: flex-end;
  justify-content: center;
  height: 158rpx;
  padding-bottom: 22rpx;
  box-sizing: border-box;
}

.brand-image {
  width: 402rpx;
  height: 104rpx;
  transform: translateY(18rpx);
}

.hero-section {
  position: relative;
  height: 900rpx;
  overflow: hidden;
  border-radius: 48rpx 38rpx 52rpx 42rpx;
  background: #fbf6f0;
}

.hero-image {
  width: 100%;
  height: 100%;
}

.weather-card {
  position: absolute;
  bottom: 25rpx;
  left: 4rpx;
  display: flex;
  align-items: center;
  width: 268rpx;
  min-height: 104rpx;
  padding: 12rpx 13rpx 12rpx 10rpx;
  border: 2rpx solid rgba(139, 105, 89, 0.46);
  border-radius: 48rpx 30rpx 42rpx 34rpx / 34rpx 46rpx 31rpx 43rpx;
  background: #fbf6f0;
  box-sizing: border-box;
  box-shadow: 0 7rpx 18rpx rgba(118, 87, 93, 0.05);
  transform: rotate(-0.45deg);
}

.weather-icon-image {
  flex: 0 0 57rpx;
  width: 57rpx;
  height: 48rpx;
}

.weather-content {
  min-width: 0;
  flex: 1;
}

.weather-primary {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
  min-width: 0;
}

.weather-temp,
.weather-copy,
.weather-tip {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.weather-temp {
  flex: 0 0 auto;
  font-size: 27rpx;
  font-weight: 600;
  font-family: "Kaiti SC", "STKaiti", "KaiTi", serif;
}

.weather-copy {
  min-width: 0;
  color: #5f5552;
  font-size: 22rpx;
  font-weight: 500;
  font-family: "Kaiti SC", "STKaiti", "KaiTi", serif;
}

.weather-tip {
  display: block;
  margin-top: 4rpx;
  color: #726965;
  font-size: 18rpx;
  font-family: "Kaiti SC", "STKaiti", "KaiTi", serif;
}

.card-arrow {
  margin-left: 1rpx;
  color: #8d646d;
  font-size: 27rpx;
}

.add-row button::after {
  border: 0;
}

.entry-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin-top: 24rpx;
}

.entry-card {
  position: relative;
  display: flex;
  height: 250rpx;
  padding: 26rpx 18rpx 22rpx;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  overflow: hidden;
  border: 2rpx solid rgba(189, 115, 129, .54);
  border-radius: 34rpx 23rpx 38rpx 27rpx / 25rpx 37rpx 23rpx 35rpx;
  background: #fbf6f0;
  box-sizing: border-box;
  transform: rotate(-.35deg);
}

.entry-card.record-entry {
  border-radius: 24rpx 39rpx 27rpx 36rpx / 37rpx 25rpx 40rpx 26rpx;
  transform: rotate(.35deg);
}

.entry-title {
  margin-top: 6rpx;
  color: #6f5057;
  font-size: 30rpx;
  font-weight: 500;
  line-height: 1.25;
  font-family: "Kaiti SC", "STKaiti", "KaiTi", serif;
}

.entry-icon {
  width: 158rpx;
  height: 142rpx;
}

.add-row {
  display: flex;
  margin-top: 24rpx;
}

.add-row button {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  height: 76rpx;
  padding: 0 24rpx;
  border: 2rpx solid rgba(189, 115, 129, 0.9);
  border-radius: 47rpx 39rpx 45rpx 41rpx / 38rpx 46rpx 37rpx 45rpx;
  background: #fbf6f0;
  color: #bd7381;
  font-family: "Kaiti SC", "STKaiti", "KaiTi", serif;
  font-size: 25rpx;
  font-weight: 500;
  line-height: 1;
}
