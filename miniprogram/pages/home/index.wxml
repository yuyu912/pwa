<view class="home-page">
  <view class="top-space"><image class="brand-image" src="/assets/home-brand-wardrobloom-v1.jpg" mode="aspectFit" /></view>
  <view class="hero-section">
    <image wx:if="{{!imageErrors.hero}}" class="hero-image" src="/assets/home-wardrobe-house-v2.jpg" mode="aspectFit" data-id="hero" binderror="onActionImageError" />
    <view class="weather-card" bindtap="toWeather">
      <image class="weather-icon-image" src="/assets/weather-{{weatherIcon}}.png" mode="aspectFit" />
      <view class="weather-content"><view class="weather-primary"><text class="weather-temp">{{weatherTemp}}</text><text class="weather-copy">{{weatherCopy}}</text></view><text class="weather-tip">{{weatherTip}}</text></view><text class="card-arrow">›</text>
    </view>
  </view>

  <view class="add-row"><button bindtap="toAdd">＋ 录入衣物</button></view>

  <view class="entry-grid">
    <view class="entry-card wardrobe-entry" bindtap="toWardrobe">
      <image class="entry-icon" src="/assets/home-entry-wardrobe-v2.jpg" mode="aspectFit" />
      <text class="entry-title">我的衣橱</text>
    </view>
    <view class="entry-card record-entry" bindtap="toOutfitGallery">
      <image class="entry-icon" src="/assets/home-entry-outfit-v2.jpg" mode="aspectFit" />
      <text class="entry-title">我的搭配</text>
    </view>
  </view>

</view>
