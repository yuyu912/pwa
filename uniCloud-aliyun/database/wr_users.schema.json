{
  "bsonType": "object",
  "description": "衣橱关系账号，仅允许云函数访问",
  "required": ["username", "password_hash", "recovery_hash", "created_at"],
  "permission": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false,
    "count": false
  },
  "properties": {
    "_id": { "bsonType": "string", "description": "账号 ID" },
    "username": { "bsonType": "string", "minLength": 2, "maxLength": 30 },
    "password_hash": { "bsonType": "string" },
    "recovery_hash": { "bsonType": "string" },
    "created_at": { "bsonType": "string" },
    "status": { "bsonType": "string" },
    "deletion_requested_at": { "bsonType": "string" },
    "entitlement_initialized_at": { "bsonType": "string", "description": "首次登录权益框架版本的服务端时间" },
    "trial_started_at": { "bsonType": "string", "description": "七天试用开始时间" },
    "trial_ends_at": { "bsonType": "string", "description": "七天试用结束时间" },
    "subscription_ends_at": { "bsonType": "string", "description": "未来真实订阅到期时间，本阶段不写入" }
  }
}
