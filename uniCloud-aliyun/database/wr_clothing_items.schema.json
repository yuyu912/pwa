{
  "bsonType": "object",
  "description": "正式衣物，仅允许云函数访问",
  "required": ["user_id", "image_key", "name", "category", "styles", "scenes", "wear_count", "status", "created_at"],
  "permission": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false,
    "count": false
  },
  "properties": {
    "_id": { "bsonType": "string" },
    "user_id": { "bsonType": "string" },
    "image_key": { "bsonType": "string" },
    "name": { "bsonType": "string", "maxLength": 80 },
    "category": { "bsonType": "string" },
    "color": { "bsonType": "string" },
    "season": { "bsonType": "string" },
    "thickness": { "bsonType": "string" },
    "pattern": { "bsonType": "string" },
    "material": { "bsonType": "string" },
    "styles": { "bsonType": "array", "arrayType": "string" },
    "scenes": { "bsonType": "array", "arrayType": "string" },
    "price": { "description": "可选价格" },
    "wear_count": { "bsonType": "int", "minimum": 0 },
    "status": { "bsonType": "string" },
    "idle_status": { "bsonType": "string", "description": "私人闲置状态：active 或 considering" },
    "idle_reason": { "bsonType": "string", "description": "用户选择的私人闲置原因" },
    "idle_note": { "bsonType": "string", "maxLength": 100, "description": "仅本人可见的闲置备注" },
    "idle_marked_at": { "bsonType": "string", "description": "标记考虑闲置的时间" },
    "source_hash": { "description": "原图 SHA-256" },
    "source_hash_key": { "description": "用户与原图哈希的唯一键" },
    "search_entity_id": { "description": "图像搜索实体 ID" },
    "created_at": { "bsonType": "string" }
  }
}
