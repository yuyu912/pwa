# CloudBase 云托管
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
APP_ORIGIN=https://replace-with-cloudbase-domain
COOKIE_SECURE=true
JWT_SECRET=
ADMIN_BOOTSTRAP_TOKEN=

# CloudBase MySQL（与云托管处于同一环境/网络）
DB_DRIVER=mysql
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_CONNECTION_LIMIT=4

# 现有腾讯云 COS / 数据万象 / 图像搜索 / VITA
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=wardrobe-relation-1458910175
COS_REGION=ap-guangzhou
COS_CI_ENABLED=true
TIIA_GROUP_ID=wardrobe_items
TIIA_REGION=ap-guangzhou
VITA_API_KEY=
VITA_MODEL=vita-video-3.0
