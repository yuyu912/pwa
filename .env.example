# 本地开发
PORT=3000
HOST=0.0.0.0
APP_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_BOOTSTRAP_TOKEN=replace-with-a-separate-admin-token

# 腾讯云 COS：本地开发留空即可使用 uploads/；生产环境必须填写并使用私有桶。
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=

# 腾讯云数据万象：商品抠图。开通并授权后设置为 true。
COS_CI_ENABLED=false

# 腾讯云图像搜索：商品图像搜索 3.0 图库配置。
TIIA_GROUP_ID=wardrobe_items
TIIA_REGION=

# 腾讯云 VITA：用于衣物候选标签识别。仅部署在服务端，不可写入前端代码。
VITA_API_KEY=
VITA_MODEL=vita-video-3.0

# CloudBase 生产环境使用 MySQL；本地开发不填写时继续使用 data/wardrobe.sqlite。
DB_DRIVER=
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_CONNECTION_LIMIT=4
